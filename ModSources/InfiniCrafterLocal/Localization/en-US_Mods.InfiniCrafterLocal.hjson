	HostDelayed: "Wonder Forge: waiting for host confirmation; no second ingredient charge"
	CountdownNotice: "Wonder Forge: up to {0} s"
	LateNotice: "The alloy is still forming; another attempt may follow"

	Title: "Wonder Forge"
	Lane: "Hearth {0}"
	Craft: "Forge"
	Busy: "Forging"
	Retrieve: "Retrieve"

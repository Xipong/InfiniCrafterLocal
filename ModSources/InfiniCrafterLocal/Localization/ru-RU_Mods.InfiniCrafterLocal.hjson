Mods: {
	InfiniCrafterLocal: {


		Items: {
			InfiniCore: {
				DisplayName: Ядро Инфиникрафта
				Tooltip:
					'''
					ПКМ: открыть инвентарь и панель InfiniCraft station
					Положи два предмета в слоты A/B вручную; LocalGenerator работает на 127.0.0.1:5055
					'''
			}

			GeneratedItem.DisplayName: Сгенерированный предмет
		}

		Projectiles.GeneratedProjectile.DisplayName: Сгенерированный снаряд

		Configs: {
			InfiniVfxClientConfig: {
				DisplayName: VFX Client Options
				Headers.GeneratedVFX: Сгенерированные VFX
				ParticleSpawnMultiplier.Label: Множитель частиц
				DrawBudgetMultiplier.Label: Множитель бюджета отрисовки
				ParticleAlphaMultiplier.Label: Множитель прозрачности частиц
				PresentationLightMultiplier.Label: Множитель света эффектов
				EnableScreenCulling.Label: Отсекать эффекты вне экрана
				EnableGeneratedSpriteSilhouette.Label: Подложка силуэта снаряда
				EnableParticleLibraryBackend.Label: Включить ParticleLibrary backend
			}

			InfiniGameplayQolConfig: {
				DisplayName: InfiniCraft gameplay QoL / Игровой QoL

				Headers: {
					InfiniCraftStationQoL: InfiniCraft station QoL / QoL станции
					GeneratedGameplayQoL: Generated gameplay QoL / Игровой QoL
					GeneratedRuntimeAssetQoL: Generated runtime assets / Runtime-ассеты
				}

				EnableInventoryAssetPrefetch: {
					Label: Sprite prefetch / Предзагрузка спрайтов
					Tooltip: Когда открыт инвентарь, мягко прогревает generated-спрайты, которые скоро могут отрисоваться.
				}

				InventoryAssetPrefetchIntervalTicks: {
					Label: Prefetch interval / Интервал предзагрузки
					Tooltip: Задержка в тиках между проходами предзагрузки generated-спрайтов при открытом инвентаре.
				}

				InventoryAssetPrefetchMaxItems: {
					Label: Prefetch max items / Лимит предметов предзагрузки
					Tooltip: Сколько generated-предметов сканировать за один проход предзагрузки. Учитывает инвентарь, броню и misc equipment; прогревает только уже-authored sprite paths.
				}

				EnableGeneratedMeleeOnHitEffects: {
					Label: Generated melee on-hit / On-hit эффекты ближнего боя
					Tooltip: Разрешает точным authored runtime-событиям применять ограниченные дебаффы, лечение и impact-представление. Текст prompt не парсится.
				}

				RuntimeSpriteCacheMaxTextures: {
					Label: Runtime sprite cache size / Размер кэша спрайтов
					Tooltip: Сколько generated PNG-текстур клиент держит загруженными. Дефолт 512 похож на ванильное поведение для маленьких спрайтов; это не лимит предметов в мире.
				}

				RuntimeSpriteMaxDimensionPixels: {
					Label: Runtime sprite max side / Максимальная сторона спрайта
					Tooltip: Generated runtime PNG шире или выше этого значения не грузится. Дефолт 192 держит item/projectile-спрайты в разумных рамках и не режет чуть более крупный generated-арт.
				}

				RuntimeSpriteMaxPngFileMegabytes: {
					Label: Runtime PNG file limit / Лимит PNG-файла
					Tooltip: Один generated runtime PNG больше этого размера в мегабайтах не будет загружен как Texture2D.
				}
			}
		}
	}
}


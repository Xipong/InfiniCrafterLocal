		}

		EnableParticleLibraryBackend: {
			Label: Частицы ParticleLibrary
			Tooltip: "Включает явно выбранные libraryParticle. Старые pl:* выбирают Terraria Dust как раньше; отключение не подменяет новые эффекты Dust."
		}

		EnableLuminanceScreenShakeBackend: {
			Label: Тряска камеры Luminance
			Tooltip: "Включает явно выбранные screenShakeCue. Собственные настройки Luminance сохраняют приоритет; автоматическая тряска от попадания не добавляется."
		}


	}
}

# Resonance Lattice localization (Russian). UTF-8 only.
Mods: {
	ResonanceLattice: {
		Items: {
			ResonantConduitItem: {
				DisplayName: "Резонансный проводник"
				Tooltip: "Устанавливает резонансный кристалл\nКристаллы в пределах 12 тайлов объединяются в решётку, проводящую эфирный заряд\nЗаряд светится, питает духов и срывается в молнии при перегрузке"
			}
			AetherCellItem: {
				DisplayName: "Эфирная ячейка"
				Tooltip: "Вводит 60 ед. эфирного заряда в ближайшую решётку\nПерегруженная решётка срывается в молнию и поражает врагов"
			}
			StormcallerItem: {
				DisplayName: "Громоносец"
				Tooltip: "Стреляет болтами решётки, которые вводят заряд в сеть\nПомеченные враги получают на 30% больше урона от всех источников"
			}
			LatticeProbeItem: {
				DisplayName: "Зонд решётки"
				Tooltip: "ЛКМ: сообщить заряд ближайшей решётки и настроиться на неё, если она заряжена хотя бы наполовину\nПКМ: призвать духа решётки (макс. 2)"
			}
		}
		Tiles: {
			ResonantCrystalTile: {
				MapEntry: "Резонансный кристалл"
			}
		}
		NPCs: {
			LatticeWispNPC: {
				DisplayName: "Дух решётки"
			}
		}
		Buffs: {
			LatticeAttunementBuff: {
				DisplayName: "Настройка на решётку"
				Description: "Настроен на заряженную решётку: ускоренное восстановление маны"
			}
		}
		Chat: {
			NoNetwork: "Поблизости нет решётки."
			ProbeReport: "Решётка: узлов {0}, заряд {1}/{2} ({3}%)"
			WispSummoned: "Дух решётки откликается на зов."
			WispLimit: "У вас уже максимальное число духов."
		}
	}
}

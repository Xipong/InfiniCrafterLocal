  "source": {
    "name": "Solar Fledgling's Quantum Beacon",
    "category": "combat",
    "concept": "A fusion of the Baby Bird summon's avian companion theme and the Quantum Solar Bomb's exploding, bouncing quantum payload that releases star shards and blinks the user.",
    "realization": {
      "description": "Throws a radiant quantum solar bomb that bounces off terrain, illuminates the surroundings in bright yellow light, and upon expiration detonates in a burst of area damage, scattering a fan of solar star shards while instantly blinking the player to the detonation site.",
      "selfEvaluation": "Successfully integrates throwing bomb mechanics with expiration effects, shard spawning, and player teleportation."
    },

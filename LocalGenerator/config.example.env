# InfiniCrafterLocal v0.4.172 compact config example
# Copy to config.env or use root 04_OPEN_SETTINGS_GUI.bat / LocalGenerator/settings_gui.py.

INFINI_USE_LLM=1
# report = advice only; safety = authored values + technical guards; normalize = legacy soft auto-normalization
INFINI_BALANCE_MODE=safety
# GUI state: last applied pipeline preset. Safe to edit by hand, but normally GUI owns it.
INFINI_GUI_PIPELINE_PRESET=Локалка: LM Studio + local Z-Image/sd.cpp

# LLM provider:
# local        = LM Studio / Ollama OpenAI-compatible local server
# openrouter   = OpenRouter API
# openai_compat= any other OpenAI-compatible API
INFINI_LLM_PROVIDER=local
INFINI_LMSTUDIO_URL=http://127.0.0.1:1234
INFINI_LMSTUDIO_MODEL=auto
# auto probes /v1/responses once per profile and falls back to /v1/chat/completions.
INFINI_LLM_API_MODE=auto
# Provider failure retries the same self-contained stage on the next profile.
INFINI_LLM_POOL_FAILURE_COOLDOWN_SECONDS=45
# Optional distributed item pool. One item stays on one selected profile for its full multipass.
INFINI_LLM_POOL_2_ENABLED=0
INFINI_LLM_POOL_2_PROVIDER=openai_compat
INFINI_LLM_POOL_2_BASE_URL=
INFINI_LLM_POOL_2_API_KEY=
INFINI_LLM_POOL_2_MODEL=
INFINI_LLM_POOL_2_API_MODE=auto
INFINI_LLM_POOL_3_ENABLED=0
INFINI_LLM_POOL_3_PROVIDER=openai_compat
INFINI_LLM_POOL_3_BASE_URL=
INFINI_LLM_POOL_3_API_KEY=
INFINI_LLM_POOL_3_MODEL=
INFINI_LLM_POOL_3_API_MODE=auto
INFINI_LLM_POOL_4_ENABLED=0
INFINI_LLM_POOL_4_PROVIDER=openai_compat
INFINI_LLM_POOL_4_BASE_URL=
INFINI_LLM_POOL_4_API_KEY=
INFINI_LLM_POOL_4_MODEL=
INFINI_LLM_POOL_4_API_MODE=auto

# Image generation: measured FLUX.2 Klein 4B hybrid through persistent sd.cpp.
INFINI_IMAGE_BACKEND=sdcpp
INFINI_SDCPP_SERVER_EXE=C:\Games\sdcpp-hybrid-gfx1030\sd-server.exe
INFINI_SDCPP_ROCM_COMPAT_ROOT=C:\Games\sdcpp-hybrid-gfx1030
INFINI_SDCPP_MODEL=C:\Games\sdcpp\models\Flux 2 4B\flux-2-klein-4b-Q8_0.gguf
INFINI_SDCPP_VAE=C:\Games\sdcpp\models\Flux 2 4B\ae.safetensors
INFINI_SDCPP_LLM=C:\Games\sdcpp\models\Flux 2 4B\Qwen3-4B-UD-Q5_K_XL.gguf
# Optional LoRA. In GUI you select only a concrete LoRA file;
# the hidden/backcompat INFINI_SDCPP_LORA_DIR is derived from that file on save.
# sd.cpp receives --lora-model-dir=<parent folder>; InfiniCrafter converts <lora:name:weight> input into the server's structured lora[] field.
INFINI_SDCPP_LORA_DIR=
INFINI_SDCPP_LORA_FILE=
INFINI_SDCPP_LORA_WEIGHT=0.25
INFINI_SDCPP_LORA_PROMPT_TAGS=
INFINI_SDCPP_SERVER_URL=http://127.0.0.1:7861
INFINI_SDCPP_SERVER_AUTOSTART=1
INFINI_SDCPP_SERVER_COMMAND_MODE=safe_args
INFINI_SDCPP_SERVER_COMMAND_TEMPLATE={exe} --diffusion-model {model} -l {host} --listen-port {port} -W {width} -H {height} --steps {steps} --cfg-scale {cfg} --sampling-method {sampler} {extra}
# FLUX.2 winner: TE+diffusion compute ROCm, VAE compute Vulkan, TE parameters CPU/RAM.
# Idle soak20: mean 3.408s, p95 3.441s. Game-load was not tested.
INFINI_SDCPP_SERVER_EXTRA_ARGS=-v --backend diffusion=rocm0,vae=vulkan0,te=rocm0 --params-backend te=cpu --rng cuda --flow-shift 3 --eager-load --diffusion-conv-direct --vae-conv-direct
# Optional Z-Image profile: INFINI_SDCPP_SERVER_EXTRA_ARGS=-v --backend diffusion=vulkan0,vae=vulkan0,te=vulkan0 --params-backend te=cpu --rng cuda --flow-shift 3 --eager-load --diffusion-conv-direct --vae-conv-direct
# Optional low-VRAM: INFINI_SDCPP_SERVER_EXTRA_ARGS=-v --backend diffusion=vulkan0,vae=cpu,te=cpu --rng cuda --flow-shift 3
# Optional disk params: INFINI_SDCPP_SERVER_EXTRA_ARGS=-v --backend diffusion=vulkan0,vae=cpu,te=vulkan0 --params-backend te=disk --rng cuda --flow-shift 3
# Optional compat: INFINI_SDCPP_SERVER_EXTRA_ARGS=-v --offload-to-cpu --flow-shift 3
# 1 opens a visible sd-server.exe console on Windows; 0 redirects output to log file.
INFINI_SDCPP_SERVER_SHOW_CONSOLE=1
INFINI_SDCPP_SERVER_LOG_FILE=cache/sdcpp_server.log

INFINI_SDCPP_WIDTH=512
INFINI_SDCPP_HEIGHT=512
INFINI_SDCPP_STEPS=4
INFINI_SDCPP_CFG=1.0
INFINI_SDCPP_SAMPLER=euler
# -1 = random each generation; set a positive number to reproduce sprite attempts.
INFINI_SDCPP_SEED=-1

# Z-Image Turbo prompt contract. auto = detect z-image model in sd.cpp config; 1 = force for sd.cpp; 0 = disable.
INFINI_ZIMAGE_PROMPT_CONTRACT=0
# Z-Image Turbo is driven by one positive final prompt; keep negative_prompt empty unless disabled.
INFINI_ZIMAGE_POSITIVE_ONLY=1
INFINI_ZIMAGE_PROMPT_LIMIT=1800
INFINI_ZIMAGE_RETRY_PROMPT_LIMIT=2200

# Radmin/Steam MP asset host override. Usually set through GUI Radmin/LAN overlay.
# native = PNG through Terraria packets; http = descriptor-verified /get_asset downloads.
INFINI_MP_ASSET_TRANSPORT=native
# INFINI_HOST=0.0.0.0
# INFINI_ASSET_PUBLIC_BASE_URL=http://26.x.x.x:5055
# INFINI_TERRARIA_PORT=7777

# v0.4.65 background removal protocol for Z-Image/fake pixel-art sprites.
# Keep this on sprite_keyer; old experimental/legacy modes were removed from GUI.
INFINI_REMOVE_BG=1
INFINI_BG_REMOVE_MODE=sprite_keyer
INFINI_BG_COLOR=magenta
INFINI_CHROMA_TOLERANCE=34
INFINI_ALPHA_THRESHOLD=28
INFINI_SPRITE_KEYER_SPILL_RADIUS=3
INFINI_SPRITE_KEYER_RESIDUE_STEPS=8
INFINI_SAVE_SPRITE_STAGES=0

# Sprite fill / postprocess tuning for Terraria-style slot readability
# INFINI_ITEM_ICON_TARGET_FILL=0.91
# INFINI_PROJECTILE_ICON_TARGET_FILL=0.84
# INFINI_IMPACT_ICON_TARGET_FILL=0.82
# INFINI_CHILD_ICON_TARGET_FILL=0.72
# INFINI_FIELD_ICON_TARGET_FILL=0.86
# INFINI_SPRITE_ITEM_CORE_ALPHA_THRESHOLD=56
# INFINI_SPRITE_EFFECT_CORE_ALPHA_THRESHOLD=40
# v0.4.55 master-first sprite processing: cleanup happens on full-res, final PNG is baked last.
# INFINI_SPRITE_MASTER_CANVAS=256
# INFINI_SPRITE_DOWNSCALE_FILTER=box           # box, bilinear, bicubic, lanczos
# INFINI_SPRITE_PREMULTIPLIED_RESIZE=1         # prevents magenta/key RGB bleed during resize
# INFINI_SPRITE_CHROMA_DEFRINGE=1              # removes only key-colored edge leftovers

# Keep sprite authorship on image models, not on procedural code. Missing item sprite blocks delivery by default.
# INFINI_VISUAL_STRICT_AI_AUTHORSHIP=1
# INFINI_VISUAL_ALLOW_PROCEDURAL_FALLBACK=0
INFINI_VISUAL_REQUIRE_ITEM_SPRITE=1
# Optional hard mode: fail crafts unless active image backend is Z-Image/sd.cpp.
# INFINI_VISUAL_REQUIRE_ZIMAGE_BACKEND=1

# --- OpenRouter API alternative ---
# INFINI_LLM_PROVIDER=openrouter
# INFINI_OPENROUTER_API_KEY=PASTE_KEY_HERE
# INFINI_OPENROUTER_MODEL=PASTE_MODEL_SLUG_HERE
# INFINI_LLM_RESPONSE_FORMAT=auto
INFINI_LLM_TEMPERATURE=0.38
# Optional one-shot scoped same-author repair temperature after structural/compiler rejection.
# Blank inherits the selected item profile's planner temperature; repair always uses that profile's author model.
INFINI_LLM_REAUTHOR_TEMPERATURE=
# Optional planner fallback. Blank model = disabled. If primary dies by quota/auth or misses the API twice, switch here.
INFINI_LLM_FALLBACK_PROVIDER=
INFINI_LLM_FALLBACK_MODEL=
INFINI_LLM_FALLBACK_BASE_URL=
INFINI_LLM_FALLBACK_API_KEY=PASTE_KEY_HERE
INFINI_LLM_FALLBACK_NETWORK_FAILS=2

INFINI_VISUAL_DIRECTOR_TEMPERATURE=0.42
# INFINI_LLM_MAX_TOKENS=8192
# Optional override just for the visual-director prompt-authoring hop. Blank = inherit INFINI_LLM_MAX_TOKENS
INFINI_VISUAL_DIRECTOR_MAX_TOKENS=
# Reasoning modes: off, auto, none, minimal, low, medium, high, xhigh, tokens, prompt_light, prompt_strong
# OpenRouter: sends `reasoning` object when mode is auto/effort/tokens.
# Local LM Studio/OpenAI-compatible: no `reasoning` field is sent; prompt_* only adds a private-check hint.
# INFINI_LLM_REASONING_MODE=off
# INFINI_LLM_REASONING_MAX_TOKENS=4096
# INFINI_LLM_REASONING_EXCLUDE=1
# INFINI_LLM_LOCAL_REASONING_PROMPT=1

# --- Generic OpenAI-compatible API alternative ---
# INFINI_LLM_PROVIDER=openai_compat
# INFINI_OPENAI_COMPAT_BASE_URL=https://api.example.com/v1
# INFINI_OPENAI_COMPAT_API_KEY=PASTE_KEY_HERE
# INFINI_OPENAI_COMPAT_MODEL=PASTE_MODEL_HERE

# v0.4.55: LLM provider and image backend are independent.
# Example: OpenRouter writes the item contract, local Z-Image/stable-diffusion.cpp draws sprites.
# INFINI_LLM_PROVIDER=openrouter
# INFINI_OPENROUTER_API_KEY=PASTE_KEY_HERE
# INFINI_OPENROUTER_MODEL=auto
# INFINI_IMAGE_BACKEND=sdcpp
# INFINI_SDCPP_SERVER_EXE=C:\Games\sdcpp\sd-server.exe
# INFINI_SDCPP_MODEL=C:\Games\sdcpp\models\z-image-turbo-Q6_K.gguf

# Alternative: OpenRouter/OpenAI-compatible LLM + OpenAI-compatible image API.
# INFINI_IMAGE_BACKEND=image_api
# INFINI_IMAGE_API_BASE_URL=https://api.openai.com/v1
# INFINI_IMAGE_API_KEY=PASTE_KEY_HERE
# INFINI_IMAGE_API_MODEL=gpt-image-1
# INFINI_IMAGE_API_SIZE=512x512

# Craft request behavior from tModLoader client:
# UI progress fills over 240s, but the generated item is awarded immediately when ready.
# Each HTTP craft attempt times out at 240s; the client retries once by default.
# INFINI_CRAFT_HTTP_TIMEOUT_SECONDS=900
# INFINI_CRAFT_HTTP_ATTEMPTS=2

# v0.4.55: aiStyle is kept internal/debug. LLM receives mechanical text digest instead.
INFINI_LLM_PROJECTILE_BEHAVIOR_DIGEST=1
INFINI_LLM_INCLUDE_AISTYLE=0

# ===== TRACE / DEBUG =====
# INFINI_TRACE_PROMPTS=1
# INFINI_TRACE_MAX_PROMPT_CHARS=18000
# INFINI_TRACE_EVENTS_TAIL=120

# Debug-only delivery override for consumable weapon/ammo test batches.
# Does not change the LLM prompt or canonical authored recipe. Potions/materials stay authored.
INFINI_DEBUG_ATTACK_CONSUMABLE_MIN_YIELD_ENABLED=0
INFINI_DEBUG_ATTACK_CONSUMABLE_MIN_YIELD=10

# v0.4.55: if /combine is busy, wait for active craft/cache instead of failing immediately.
INFINI_COMBINE_BUSY_WAIT_SECONDS=210

{
  "$id": "https://infinicrafter.local/contracts/visual_runtime_entities.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "animationPlan": {
      "maxLength": 1200,
      "minLength": 1,
      "type": "string"
    },
    "entities": {
      "items": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "assetMode": {
                "const": "baked_sprite"
              },
              "entityId": {
                "enum": [
                  "item",
                  "workbench_blade",
                  "nail"
                ],
                "type": "string"
              },
              "prompt": {
                "maxLength": 1400,
                "minLength": 1,
                "type": "string"
              },
              "scale": {
                "description": "Engine-units multiplicative per-entity visual factor; 1 is neutral. Not the collision hitbox size or item.worldScale: projectile draw scale multiplies hitbox.drawScale separately. no_asset entities may have no visible sprite.",
                "maximum": 4.0,
                "minimum": 0.25,
                "type": "number"
              },
              "silhouette": {
                "maxLength": 700,
                "minLength": 1,
                "type": "string"
              },
              "visualIdentity": {
                "maxLength": 700,
                "minLength": 1,
                "type": "string"
              },
              "visualProjectRef": {
                "enum": [
                  "item",
                  "entity"
                ],
                "type": "string"
              }
            },
            "required": [
              "entityId",
              "assetMode",
              "visualProjectRef",
              "prompt",
              "silhouette",
              "visualIdentity",
              "scale"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "assetMode": {
                "const": "reuse_item_icon"
              },
              "entityId": {
                "enum": [
                  "item",
                  "workbench_blade",
                  "nail"
                ],
                "type": "string"
              },
              "scale": {
                "description": "Engine-units multiplicative per-entity visual factor; 1 is neutral. Not the collision hitbox size or item.worldScale: projectile draw scale multiplies hitbox.drawScale separately. no_asset entities may have no visible sprite.",
                "maximum": 4.0,
                "minimum": 0.25,
                "type": "number"
              },
              "visualProjectRef": {
                "const": "item"
              }
            },
            "required": [
              "entityId",
              "assetMode",
              "visualProjectRef",
              "scale"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "assetMode": {
                "const": "runtime_geometry"
              },
              "entityId": {
                "enum": [
                  "item",
                  "workbench_blade",
                  "nail"
                ],
                "type": "string"
              },
              "scale": {
                "description": "Engine-units multiplicative per-entity visual factor; 1 is neutral. Not the collision hitbox size or item.worldScale: projectile draw scale multiplies hitbox.drawScale separately. no_asset entities may have no visible sprite.",
                "maximum": 4.0,
                "minimum": 0.25,
                "type": "number"
              },
              "visualProjectRef": {
                "const": "none"
              }
            },
            "required": [
              "entityId",
              "assetMode",
              "visualProjectRef",
              "scale"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "assetMode": {
                "const": "no_asset"
              },
              "entityId": {
                "enum": [
                  "item",
                  "workbench_blade",
                  "nail"
                ],
                "type": "string"
              },
              "scale": {
                "description": "Engine-units multiplicative per-entity visual factor; 1 is neutral. Not the collision hitbox size or item.worldScale: projectile draw scale multiplies hitbox.drawScale separately. no_asset entities may have no visible sprite.",
                "maximum": 4.0,
                "minimum": 0.25,
                "type": "number"
              },
              "visualProjectRef": {
                "const": "none"
              }
            },
            "required": [
              "entityId",
              "assetMode",
              "visualProjectRef",
              "scale"
            ],
            "type": "object"
          }
        ]
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    },
    "equipOverlay": {
      "additionalProperties": false,
      "properties": {
        "accessoryMount": {
          "description": "Optional accessory-only body-local badge anchor, using the existing overlay PNG, body pivot/rotation and 18px fit. chest=(0,-2), back=(-10,-4), waist=(0,10), shoulder=(8,-12) player pixels relative to center, X facing-mirrored and Y gravity-mirrored. orbit uses the existing accessory slot ring. Armor ignores this field. No atlas or gameplay change.",
          "enum": [
            "chest",
            "back",
            "waist",
            "shoulder",
            "orbit"
          ],
          "type": "string"
        },
        "preferredCanvasSize": {
          "description": "Requested square equipment-overlay PNG target canvas, in pixels per side; not the on-player display size (the draw layer fits the texture separately).",
          "enum": [
            32,
            48,
            64,
            96
          ],
          "type": "integer"
        },
        "prompt": {
          "maxLength": 1400,
          "minLength": 1,
          "type": "string"
        },
        "silhouette": {
          "maxLength": 700,
          "minLength": 1,
          "type": "string"
        },
        "visualIdentity": {
          "maxLength": 700,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "prompt",
        "silhouette",
        "visualIdentity",
        "preferredCanvasSize"
      ],
      "type": "object"
    },
    "item": {
      "additionalProperties": false,
      "properties": {
        "effectColor": {
          "description": "Optional exact runtime rendering color token shared by item, projectile and detached VFX. Independent of the rich descriptive palette used for sprite art; no hex or prose parsing. Omission preserves historical rendering behavior.",
          "enum": [
            "white",
            "gray",
            "brown",
            "tan",
            "red",
            "orange",
            "yellow",
            "gold",
            "green",
            "cyan",
            "blue",
            "purple",
            "pink",
            "black"
          ],
          "type": "string"
        },
        "grip": {
          "additionalProperties": false,
          "description": "Optional atomic hand pivot on the final item PNG canvas after crop/fit/padding, before facing/gravity flips. normalizedX=0 is left, 1 right; normalizedY=0 top, 1 bottom. Both required; no pixel units. Replaces legacy grip and artistic forward offset, not authored HoldoutOffset.",
          "properties": {
            "normalizedX": {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            "normalizedY": {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            }
          },
          "required": [
            "normalizedX",
            "normalizedY"
          ],
          "type": "object"
        },
        "inventoryScale": {
          "description": "Engine-units multiplicative inventory sprite draw factor after the texture/frame fit; 1 is neutral, not a pixel size.",
          "maximum": 4.0,
          "minimum": 0.25,
          "type": "number"
        },
        "negativePrompt": {
          "maxLength": 700,
          "type": "string"
        },
        "palette": {
          "items": {
            "maxLength": 48,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array"
        },
        "preferredCanvasSize": {
          "description": "Requested square item PNG target canvas, in pixels per side; not the item's world size or a guaranteed on-screen display size.",
          "enum": [
            24,
            32,
            48,
            64,
            96,
            128
          ],
          "type": "integer"
        },
        "prompt": {
          "maxLength": 1400,
          "minLength": 1,
          "type": "string"
        },
        "silhouette": {
          "maxLength": 700,
          "minLength": 1,
          "type": "string"
        },
        "visualIdentity": {
          "maxLength": 700,
          "minLength": 1,
          "type": "string"
        },
        "worldScale": {
          "description": "Engine-units multiplicative dropped world-item sprite draw factor applied to the engine-provided draw scale; 1 is neutral, not a pixel size or inventory scale.",
          "maximum": 4.0,
          "minimum": 0.25,
          "type": "number"
        }
      },
      "required": [
        "prompt",
        "negativePrompt",
        "silhouette",
        "visualIdentity",
        "palette",
        "preferredCanvasSize",
        "inventoryScale",
        "worldScale"
      ],
      "type": "object"
    },
    "schema": {
      "const": "infini.visual-kit.runtime-entities.v1"
    }
  },
  "required": [
    "schema",
    "item",
    "entities",
    "animationPlan"
  ],
  "type": "object",
  "x-infini-generated": true
}

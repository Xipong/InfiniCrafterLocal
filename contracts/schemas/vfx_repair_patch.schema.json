{
  "$id": "https://infinicrafter.local/contracts/vfx_repair_patch.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "effectMagnitude": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "motif": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "chaos": {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            "element": {
              "maxLength": 48,
              "minLength": 1,
              "type": "string"
            },
            "motionLanguage": {
              "maxLength": 96,
              "minLength": 1,
              "type": "string"
            },
            "paletteRole": {
              "maxLength": 48,
              "minLength": 1,
              "type": "string"
            },
            "rhythm": {
              "maximum": 3.0,
              "minimum": 0.2,
              "type": "number"
            },
            "shapeLanguage": {
              "maxLength": 96,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "element",
            "shapeLanguage",
            "motionLanguage",
            "paletteRole",
            "rhythm",
            "chaos"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "note": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "infini.vfx-repair-patch.runtime-events.v1"
    },
    "slotIdsDelete": {
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 5,
      "type": "array"
    },
    "slotIndicesDelete": {
      "items": {
        "maximum": 10,
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 10,
      "type": "array"
    },
    "slotsUpsert": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "alpha": {
            "maximum": 1.0,
            "minimum": 0.0,
            "type": "number"
          },
          "anchor": {
            "enum": [
              "self",
              "owner",
              "tip",
              "tipHistory",
              "hitPoint",
              "velocity",
              "field"
            ],
            "type": "string"
          },
          "backend": {
            "enum": [
              "Auto",
              "Realtime",
              "Primitive",
              "Sprite",
              "Particle"
            ],
            "type": "string"
          },
          "blend": {
            "enum": [
              "alpha",
              "additive"
            ],
            "type": "string"
          },
          "budgetWeight": {
            "maximum": 4.0,
            "minimum": 0.1,
            "type": "number"
          },
          "channel": {
            "enum": [
              "motionTrail",
              "coreGlow",
              "ambientParticles",
              "impactShape",
              "impactParticles",
              "decaySmoke",
              "light",
              "sound"

            "type": "string"
          },
          "fadeIn": {
            "maximum": 0.8,
            "minimum": 0.0,
            "type": "number"
          },
          "fadeOut": {
            "maximum": 0.8,
            "minimum": 0.0,
            "type": "number"
          },
          "id": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "jitter": {
            "maximum": 1.5,
            "minimum": 0.0,
            "type": "number"
          },
          "lane": {
            "enum": [
              "primary",
              "support",
              "accent",
              "ornament",
              "cue"

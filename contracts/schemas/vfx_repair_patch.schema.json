            "type": "string"
          },
          "density": {
            "maximum": 1.0,
            "minimum": 0.0,
            "type": "number"
          },
          "duration": {
            "maximum": 120,
            "minimum": 3,
            "type": "integer"
          },
          "emissionMode": {
            "enum": [
              "wake",
              "orbit",
              "residue",
              "burst",
              "cone",
              "ring",
              "spiral",
              "none"
            ],
            "type": "string"
          },
          "entityId": {
            "enum": [
              "item",
              "nail",
              "workbench_blade"
            ],
            "type": "string"
          },
          "event": {
            "enum": [
              "on_crit",
              "on_expire",
              "on_hit",
              "on_kill",
              "on_spawn",
              "on_tile_collision",
              "on_use",
              "periodic"

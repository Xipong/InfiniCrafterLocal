            "type": "string"
          },
          "particleRole": {
            "enum": [
              "item",
              "entity",
              "projectile",
              "field",
              "impact",
              "none"
            ],
            "type": "string"
          },
          "particleSystemId": {
            "enum": [
              "dust",
              "pl:glow",
              "pl:shard",
              "pl:smoke",
              "pl:spark",
              "none"
            ],
            "type": "string"
          },
          "rendererKind": {
            "enum": [
              "projectileAfterimage",
              "spriteStampTrail",
              "historyRibbon",
              "tipTrail",
              "ghostArc",
              "wavyStrip",
              "beamLine",
              "fieldPulse",
              "orbitingMotes",
              "actorAfterimage",
              "impactRing",
              "impactSprite",
              "childMotes",
              "lightCue",
              "soundCue"
            ],
            "type": "string"
          },
          "repeatEvery": {
            "maximum": 120,
            "minimum": 0,
            "type": "integer"
          },
          "scale": {
            "maximum": 5.0,
            "minimum": 0.15,
            "type": "number"
          },
          "signatureWeight": {
            "maximum": 1.0,
            "minimum": 0.0,
            "type": "number"
          },
          "spread": {
            "maximum": 2.0,
            "minimum": 0.0,
            "type": "number"
          },
          "spriteNegativePrompt": {
            "maxLength": 700,
            "type": "string"
          },
          "spritePrompt": {
            "maxLength": 1400,
            "type": "string"
          },
          "startTick": {
            "maximum": 120,
            "minimum": 0,
            "type": "integer"
          },
          "textureRole": {
            "enum": [
              "item",
              "entity",
              "projectile",
              "field",
              "impact",
              "none"
            ],
            "type": "string"
          },
          "visualCost": {
            "maximum": 1.0,
            "minimum": 0.0,
            "type": "number"
          }
        },
        "required": [
          "id",
          "entityId",
          "event",
          "rendererKind",
          "backend",
          "textureRole",
          "particleRole",
          "anchor",
          "channel",
          "lane",
          "emissionMode",
          "blend",
          "layer",
          "particleSystemId",
          "scale",
          "density",
          "duration",
          "alpha",
          "spread",
          "jitter",
          "fadeIn",
          "fadeOut",
          "budgetWeight",
          "signatureWeight",
          "visualCost",
          "startTick",
          "repeatEvery",
          "spritePrompt",
          "spriteNegativePrompt"
        ],
        "type": "object"
      },
      "maxItems": 5,
      "type": "array"
    },
    "visualBudgetClass": {
      "anyOf": [
        {
          "enum": [
            "tiny",
            "small",
            "normal",
            "large",
            "signature"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "effectMagnitude",
    "visualBudgetClass",
    "motif",
    "slotsUpsert",
    "slotIdsDelete",
    "slotIndicesDelete",
    "note"
  ],
  "type": "object",
  "x-infini-generated": true
}

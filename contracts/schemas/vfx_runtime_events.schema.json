{
  "$id": "https://infinicrafter.local/contracts/vfx_runtime_events.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "effectMagnitude": {
      "description": "Engine units: Retained presentation metadata; currently no renderer consumer. Not a physical intensity or budget multiplier.",
      "maximum": 1.0,
      "minimum": 0.0,
      "type": "number"
    },
    "motif": {
      "additionalProperties": false,
      "properties": {
        "chaos": {
          "description": "Engine units: Retained motif metadata; currently no renderer consumer. Not a probability.",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "element": {
          "maxLength": 48,
          "minLength": 1,
          "type": "string"
        },
        "motionLanguage": {
          "maxLength": 96,
          "minLength": 1,
          "type": "string"
        },
        "paletteRole": {
          "maxLength": 48,
          "minLength": 1,
          "type": "string"
        },
        "rhythm": {
          "description": "Engine units: Retained motif metadata; currently no renderer consumer. Not beats per minute or a time unit.",
          "maximum": 3.0,
          "minimum": 0.2,
          "type": "number"
        },
        "shapeLanguage": {
          "maxLength": 96,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "element",
        "shapeLanguage",
        "motionLanguage",
        "paletteRole",
        "rhythm",
        "chaos"
      ],
      "type": "object"
    },
    "schema": {
      "const": "infini.vfx-director.runtime-events.v2"
    },
    "slots": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "rendererKind": {
                  "const": "lightCue"
                }
              },
              "required": [
                "rendererKind"
              ]
            },
            "then": {
              "properties": {
                "channel": {
                  "const": "light"
                },
                "lane": {
                  "const": "cue"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "rendererKind": {
                  "const": "soundCue"
                }
              },
              "required": [
                "rendererKind"
              ]
            },
            "then": {
              "properties": {
                "channel": {
                  "const": "sound"
                },
                "lane": {
                  "const": "cue"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "rendererKind": {
                  "const": "impactSprite"
                }
              },
              "required": [
                "rendererKind"
              ]
            },
            "then": {
              "properties": {
                "textureRole": {
                  "const": "impact"
                }
              }
            }
          }
        ],
        "properties": {
          "alpha": {
            "description": "Engine units: Renderer-specific opacity/volume coefficient: projectile sprite/primitive draw color multiplied by alpha; impactSprite fades from alpha over its lifetime; sound volume clamp(alpha, 0.05, 1). Projectile and item dust color paths do not use slot alpha; not universal opacity.",
            "maximum": 1.0,
            "minimum": 0.0,
            "type": "number"
          },
          "anchor": {
            "enum": [
              "self",
              "owner",
              "tip",
              "tipHistory",
              "hitPoint",
              "velocity",
              "field"
            ],
            "type": "string"
          },
          "backend": {
            "enum": [
              "Auto",
              "Realtime",
              "Primitive",
              "Sprite",
              "Particle"
            ],
            "type": "string"
          },
          "blend": {
            "enum": [
              "alpha",
              "additive"
            ],
            "type": "string"
          },
          "budgetWeight": {
            "description": "Engine units: Retained weighting metadata; currently no renderer consumer. Does not multiply an enforced particle/draw budget.",
            "maximum": 4.0,
            "minimum": 0.1,
            "type": "number"
          },
          "channel": {
            "enum": [
              "motionTrail",
              "coreGlow",
              "ambientParticles",
              "impactShape",
              "impactParticles",
              "decaySmoke",
              "light",
              "sound"
            ],
            "type": "string"
          },
          "density": {
            "description": "Engine units: Renderer-specific count/cadence coefficient, not particles per world tick: projectile periodic repeatEvery=0 uses clamp(14-round(8*density), 4, 18) world ticks; projectile impactRing/childMotes count clamp(2+round(8*density), 2, 10), item dust count clamp(1+round(7*density), 1, 8), subject to client scaling and budget.",
            "maximum": 1.0,
            "minimum": 0.0,
            "type": "number"
          },
          "duration": {
            "description": "impactSprite lifetime in world ticks only; detached sprite fades linearly with elapsed world ticks and is removed at duration. Other renderer kinds do not consume duration.",
            "maximum": 120,
            "minimum": 3,
            "type": "integer"
          },
          "emissionMode": {
            "enum": [
              "wake",
              "orbit",
              "residue",
              "burst",
              "cone",
              "ring",
              "spiral",
              "none"
            ],
            "type": "string"
          },
          "entityId": {
            "enum": [
              "item",
              "nail",
              "workbench_blade"
            ],
            "type": "string"
          },
          "event": {
            "enum": [
              "on_crit",
              "on_expire",
              "on_hit",
              "on_kill",
              "on_spawn",
              "on_tile_collision",
              "on_use",
              "periodic"
            ],
            "type": "string"
          },
          "fadeIn": {
            "description": "Engine units: Retained metadata; currently no renderer consumer. Not seconds, world ticks, or a lifetime fraction.",
            "maximum": 0.8,
            "minimum": 0.0,
            "type": "number"
          },
          "fadeOut": {
            "description": "Engine units: Retained metadata; currently no renderer consumer. Not seconds, world ticks, or a lifetime fraction; impactSprite has its own fixed linear fade.",
            "maximum": 0.8,
            "minimum": 0.0,
            "type": "number"
          },
          "id": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "jitter": {
            "description": "Engine units: Retained metadata; currently no renderer consumer. No pixel, angle, or time unit.",
            "maximum": 1.5,
            "minimum": 0.0,
            "type": "number"
          },
          "lane": {
            "enum": [
              "primary",
              "support",
              "accent",
              "ornament",
              "cue"
            ],
            "type": "string"
          },
          "layer": {
            "enum": [
              "BeforeProjectiles",
              "AfterProjectiles"
            ],
            "type": "string"
          },
          "particleRole": {
            "enum": [
              "item",
              "entity",
              "projectile",
              "field",
              "impact",
              "none"
            ],
            "type": "string"
          },
          "particleSystemId": {
            "enum": [
              "dust",
              "pl:glow",
              "pl:shard",
              "pl:smoke",
              "pl:spark",
              "none"
            ],
            "type": "string"
          },
          "rendererKind": {
            "description": "Select the renderer with the companion fields required by this slot's conditional clauses. lightCue emits world lighting, not a drawn glow sprite or trail. Sound/light cues use lane=cue, not a visual emphasis lane.",
            "enum": [
              "projectileAfterimage",
              "spriteStampTrail",
              "historyRibbon",
              "tipTrail",
              "ghostArc",
              "wavyStrip",
              "beamLine",
              "fieldPulse",
              "orbitingMotes",
              "actorAfterimage",
              "impactRing",
              "impactSprite",
              "childMotes",
              "lightCue",
              "soundCue"
            ],
            "type": "string"
          },
          "repeatEvery": {
            "description": "Periodic cadence in world ticks only; 0 means automatic, not zero ticks: projectile periodic uses clamp(14-round(8*density), 4, 18), item periodic uses 10. Positive values use projectile state ticks or item global update ticks with slot-seed phase; event paths ignore repeatEvery.",
            "maximum": 120,
            "minimum": 0,
            "type": "integer"
          },
          "scale": {
            "description": "Engine units: Renderer-specific coefficient (1 is nominal): sprite trail draw scale = max(0.05, projectile.scale * scale); primitive thickness max(1, 2*scale), beam length max(20, 48*scale), cross radius max(4, 9*scale); light strength clamp(0.22*scale, 0.04, 1.2) on projectile or clamp(0.2*scale, 0.04, 1.2) on item, then client multiplier; dust size clamp(scale, 0.2, 3); impactSprite draw scale further clamped. Not a universal size in pixels.",
            "maximum": 5.0,
            "minimum": 0.15,
            "type": "number"
          },
          "signatureWeight": {
            "description": "Engine units: Retained weighting metadata; currently no renderer consumer. Not an enforced budget fraction.",
            "maximum": 1.0,
            "minimum": 0.0,
            "type": "number"
          },
          "spread": {
            "description": "Engine units: Particle-speed coefficient, not angle or radians: projectile dust speed clamp(0.35+1.7*spread, 0.2, 4) plus inherited velocity; item dust velocity sampled from circular radii 1+spread. Angle is selected separately; not one common physical speed.",
            "maximum": 2.0,
            "minimum": 0.0,
            "type": "number"
          },
          "spriteNegativePrompt": {
            "maxLength": 700,
            "type": "string"
          },
          "spritePrompt": {
            "maxLength": 1400,
            "type": "string"
          },
          "startTick": {
            "description": "Projectile periodic only: initial gate on per-projectile state world tick (one increment per distinct GameUpdateCount); 0 means no initial gate. Item periodic and event paths ignore startTick.",
            "maximum": 120,
            "minimum": 0,
            "type": "integer"
          },
          "textureRole": {
            "enum": [
              "item",
              "entity",
              "projectile",
              "field",
              "impact",
              "none"
            ],
            "type": "string"
          },
          "visualCost": {
            "description": "Engine units: Retained cost metadata; currently no renderer consumer. Not draw calls or an enforced budget fraction.",
            "maximum": 1.0,
            "minimum": 0.0,
            "type": "number"
          }
        },
        "required": [
          "id",
          "entityId",
          "event",
          "rendererKind",
          "backend",
          "textureRole",
          "particleRole",
          "anchor",
          "channel",
          "lane",
          "emissionMode",
          "blend",
          "layer",
          "particleSystemId",
          "scale",
          "density",
          "duration",
          "alpha",
          "spread",
          "jitter",
          "fadeIn",
          "fadeOut",
          "budgetWeight",
          "signatureWeight",
          "visualCost",
          "startTick",
          "repeatEvery",
          "spritePrompt",
          "spriteNegativePrompt"
        ],
        "type": "object"
      },
      "maxItems": 5,
      "minItems": 0,
      "type": "array"
    },
    "visualBudgetClass": {
      "enum": [
        "tiny",
        "small",
        "normal",
        "large",
        "signature"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema",
    "effectMagnitude",
    "visualBudgetClass",
    "motif",
    "slots"
  ],
  "type": "object",
  "x-infini-generated": true
}

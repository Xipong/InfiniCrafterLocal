{
  "schema": "infini.agent-manifest.v2",
  "project": "InfiniCrafterLocal",
  "projectVersion": "0.5.1",
  "runtimeApiVersion": "infini.runtime-program.v5",
  "testSuiteVersion": "low-level-v5",
  "testSuitePolicy": "Run bounded focused gates during edits; final acceptance requires behavioral pytest, schema/generated-document freshness, prompt budgets, hygiene/static C# policies, and real native builds and execution when prerequisites are available.",
  "canonicalOwners": {
    "capabilityRegistry": "generator/infini_local/core/runtime_authoring/capability_registry.py",
    "authorSchema": "generator/infini_local/core/runtime_authoring/program_schema.py",
    "authorValidator": "generator/infini_local/core/runtime_authoring/validator.py",
    "wireCompiler": "generator/infini_local/core/runtime_authoring/compiler.py",
    "technicalLowering": "generator/infini_local/core/runtime_authoring/technical_lowering.py",
    "strictWireBoundary": "generator/infini_local/core/runtime_authoring/wire_validator.py",
    "csharpDto": "mod/InfiniCrafterLocal/Common/Models/Contracts/RuntimeProgramSpec.cs",
    "csharpItemProjection": "mod/InfiniCrafterLocal/Common/Models/Runtime/GeneratedItemData.Apply.cs",
    "csharpProjectileRuntime": "mod/InfiniCrafterLocal/Content/Projectiles/Motion/GeneratedProjectile.ComposableMotion.cs",
    "csharpEventRuntime": "mod/InfiniCrafterLocal/Common/Runtime/RuntimeProgramExecutor.cs",
    "projectileNetwork": "mod/InfiniCrafterLocal/Content/Projectiles/Networking/GeneratedProjectile.NetSync.cs",
    "visualDirectorContract": "generator/infini_local/pipelines/visual/contract.py",
    "vfxDirectorContract": "generator/infini_local/core/vfx/schema.py",
    "capabilityInventory": "docs/reference/generated/LOW_LEVEL_CAPABILITY_INVENTORY_RU.md",
    "terrariaVocabulary": "generator/infini_local/core/runtime_authoring/terraria_vocabulary.py",
    "aliasPolicy": "docs/reference/generated/LOWERY_RU.md",
    "gameplayStage": "generator/infini_local/pipelines/author/stage.py",
    "wirePresentationViews": "generator/infini_local/core/runtime_authoring/wire_views.py",
    "vfxTransport": "generator/infini_local/pipelines/vfx/request.py",
    "parentNativeFacts": "mod/InfiniCrafterLocal/Common/Services/Generation/GeneratorClient.ParentFacts.cs",
    "vfxDirectorStage": "generator/infini_local/pipelines/vfx/stage.py",
    "providerSchema": "generator/infini_local/core/provider_schema.py"
  },
  "checks": {
    "pytest": [
      "python",
      "tools/testing/run_pytest_shards.py",
      "--shards",
      "6",
      "--timeout-seconds",
      "300",
      "--json-out",
      "artifacts/validation/pytest_shards.json"
    ],
    "compileall": [
      "python",
      "-m",
      "compileall",
      "-q",
      "generator",
      "tools",
      "toolbox"
    ],
    "schema_check": [
      "python",
      "tools/generate/export_contract_schemas.py",
      "--check"
    ],
    "generated_docs": [
      "python",
      "tools/generate/generate_low_level_runtime_docs.py",
      "--check"
    ],
    "planner_prompt": [
      "python",
      "tools/checks/check_planner_prompt_usability.py"
    ],
    "csharp_contracts": [
      "python",
      "tools/checks/check_csharp_contracts.py"
    ],
    "project_hygiene": [
      "python",
      "tools/checks/check_project_hygiene.py"
    ],
    "config_registry": [
      "python",
      "tools/generate/config_registry.py",
      "--check"
    ],
    "portable_sandbox": [
      "python",
      "tools/testing/validate_sandbox.py"
    ],
    "ruff": [
      "ruff",
      "check",
      "generator/infini_local",
      "tools",
      "toolbox"
    ],
    "pyright": [
      "pyright"
    ],
    "tml_build": [
      "dotnet",
      "build",
      "mod/InfiniCrafterLocal/InfiniCrafterLocal.csproj"
    ],
    "targeted_repair": [
      "python",
      "tools/checks/audit_targeted_repair.py",
      "--check"
    ],
    "lowery": [
      "python",
      "tools/generate/generate_lowery.py",
      "--check"
    ],
    "equipment_bounds": [
      "python",
      "tools/generate/generate_equipment_bounds.py",
      "--check"
    ],
    "handbook": [
      "python",
      "tools/build_documentation.py",
      "--check"
    ],
    "native_checks": [
      "dotnet",
      "build",
      "tests/native/EngineRuntimeChecks.csproj"
    ],
    "tml_runtime_selftest": [
      "python",
      "tools/checks/check_tml_selftest_report.py"
    ],
    "tml_ci_regression": [
      "python",
      "tools/testing/test_tml_ci.py",
      "-v"
    ],
    "item_workbench_python": [
      "python",
      "tools/workbench/workbench.py",
      "test"
    ],
    "item_workbench_build": [
      "python",
      "tools/workbench/workbench.py",
      "build"
    ]
  },
  "fullChecks": [
    "pytest",
    "compileall",
    "tml_ci_regression",
    "item_workbench_python",
    "schema_check",
    "generated_docs",
    "planner_prompt",
    "csharp_contracts",
    "project_hygiene",
    "config_registry",
    "ruff",
    "pyright",
    "targeted_repair",
    "lowery",
    "equipment_bounds",
    "handbook",
    "tml_build",
    "native_checks",
    "item_workbench_build",
    "tml_runtime_selftest"
  ],
  "validationGroups": {
    "python": [
      "pytest",
      "compileall",
      "tml_ci_regression",
      "item_workbench_python"
    ],
    "static": [
      "schema_check",
      "generated_docs",
      "planner_prompt",
      "csharp_contracts",
      "project_hygiene",
      "config_registry",
      "ruff",
      "pyright",
      "targeted_repair",
      "lowery",
      "equipment_bounds",
      "handbook"
    ],
    "build": [
      "tml_build",
      "native_checks",
      "item_workbench_build",
      "tml_runtime_selftest"
    ]
  },
  "refreshGroups": {
    "runtime": [
      [
        "python",
        "tools/generate/export_contract_schemas.py"
      ],
      [
        "python",
        "tools/generate/generate_equipment_bounds.py"
      ],
      [
        "python",
        "tools/generate/generate_lowery.py"
      ],
      [
        "python",
        "tools/generate/generate_low_level_runtime_docs.py"
      ],
      [
        "python",
        "tools/checks/audit_targeted_repair.py",
        "--output",
        "contracts/targeted_repair_audit.generated.json"
      ]
    ],
    "config": [
      [
        "python",
        "tools/generate/config_registry.py"
      ]
    ],
    "docs": [
      [
        "python",
        "tools/build_documentation.py"
      ]
    ]
  }
}

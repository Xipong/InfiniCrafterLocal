{
  "schema": "infini.agent-manifest.v2",
  "project": "InfiniCrafterLocal",
  "projectVersion": "0.5.03",
  "runtimeApiVersion": "infini.runtime-program.v5",
  "testSuiteVersion": "low-level-v5",
  "testSuitePolicy": "Run bounded focused gates during edits; final acceptance requires full pytest, schema/prompt/delivery/parity/mutation/hygiene/static C# gates, and a real tModLoader build when the SDK and mod references are available.",
  "canonicalOwners": {
    "capabilityRegistry": "LocalGenerator/infini_local/core/runtime_authoring/capability_registry.py",
    "authorSchema": "LocalGenerator/infini_local/core/runtime_authoring/program_schema.py",
    "authorValidator": "LocalGenerator/infini_local/core/runtime_authoring/validator.py",
    "wireCompiler": "LocalGenerator/infini_local/core/runtime_authoring/compiler.py",
    "technicalLowering": "LocalGenerator/infini_local/core/runtime_authoring/technical_lowering.py",
    "strictWireBoundary": "LocalGenerator/infini_local/core/runtime_authoring/wire_validator.py",
    "csharpDto": "ModSources/InfiniCrafterLocal/Common/Models/Contracts/RuntimeProgramSpec.cs",
    "csharpItemProjection": "ModSources/InfiniCrafterLocal/Common/Models/Runtime/GeneratedItemData.Apply.cs",
    "csharpProjectileRuntime": "ModSources/InfiniCrafterLocal/Content/Projectiles/GeneratedProjectile.Executors.cs",
    "csharpEventRuntime": "ModSources/InfiniCrafterLocal/Common/Runtime/RuntimeProgramExecutor.cs",
    "projectileNetwork": "ModSources/InfiniCrafterLocal/Content/Projectiles/GeneratedProjectile.NetSync.cs",
    "visualDirectorContract": "LocalGenerator/infini_local/pipelines/visual_asset_plan.py",
    "vfxDirectorContract": "LocalGenerator/infini_local/core/vfx_manifest.py",
    "capabilityInventory": "docs/reference/generated/LOW_LEVEL_CAPABILITY_INVENTORY_RU.md",
    "terrariaVocabulary": "LocalGenerator/infini_local/core/runtime_authoring/terraria_vocabulary.py",
    "aliasPolicy": "docs/reference/generated/LOWERY_RU.md",
    "gameplayStage": "LocalGenerator/infini_local/pipelines/gameplay_stage.py",
    "wirePresentationViews": "LocalGenerator/infini_local/core/runtime_authoring/wire_views.py",
    "vfxTransport": "LocalGenerator/infini_local/pipelines/vfx_generation_pipeline.py",
    "parentNativeFacts": "ModSources/InfiniCrafterLocal/Common/Services/Generation/GeneratorClient.cs"
  },
  "checks": {
    "pytest": [
      "python",
      "tools/run_pytest_shards.py",
      "--shards",
      "4",
      "--timeout-seconds",
      "300",
      "--json-out",
      "artifacts/validation/pytest_shards.json"
    ],
    "compileall": [
      "python",
      "-m",
      "compileall",
      "-q",
      "LocalGenerator",
      "tools",
      "toolbox"
    ],
    "schema_check": [
      "python",
      "tools/export_contract_schemas.py",
      "--check"
    ],
    "capability_audit": [
      "python",
      "tools/audit_capability_library.py"
    ],
    "generated_docs": [
      "python",
      "tools/generate_low_level_runtime_docs.py",
      "--check"
    ],
    "delivery_contract": [
      "python",
      "tools/check_delivery_contract.py"
    ],
    "contract_parity": [
      "python",
      "tools/contract_parity.py"
    ],
    "mutation_gate": [
      "python",
      "tools/mutation_contract_gate.py"
    ],
    "planner_prompt": [
      "python",
      "tools/check_planner_prompt_usability.py"
    ],
    "semantic_runtime_diff": [
      "python",
      "tools/semantic_runtime_diff.py"
    ],
    "runtime_impact": [
      "python",
      "tools/runtime_impact_report.py"
    ],
    "csharp_contracts": [
      "python",
      "tools/check_csharp_contracts.py"
    ],
    "project_hygiene": [
      "python",
      "tools/check_project_hygiene.py"
    ],
    "config_registry": [
      "python",
      "tools/config_registry.py",
      "--check"
    ],
    "portable_sandbox": [
      "python",
      "tools/validate_sandbox.py"
    ],
    "ruff": [
      "ruff",
      "check",
      "LocalGenerator/infini_local",
      "tools",
      "toolbox"
    ],
    "pyright": [
      "pyright"
    ],
    "tml_build": [
      "dotnet",
      "build",
      "ModSources/InfiniCrafterLocal/InfiniCrafterLocal.csproj"
    ],
    "terraria_standardization": [
      "python",
      "tools/audit_terraria_standardization.py",
      "--check"
    ],
    "targeted_repair": [
      "python",
      "tools/audit_targeted_repair.py",
      "--check"
    ],
    "lowery": [
      "python",
      "tools/generate_lowery.py",
      "--check"
    ],
    "equipment_bounds": [
      "python",
      "tools/generate_equipment_bounds.py",
      "--check"
    ],
    "primitive_parity": [
      "python",
      "tools/generate_primitive_parity.py",
      "--check"
    ],
    "handbook": [
      "python",
      "tools/build_documentation.py",
      "--check"
    ],
    "primitive_loss": [
      "python",
      "-m",
      "infini_local.qa.primitive_loss_audit"
    ],
    "native_checks": [
      "dotnet",
      "build",
      "tools/EngineRuntimeChecks.csproj"
    ],
    "tml_runtime_selftest": [
      "python",
      "tools/check_tml_selftest_report.py"
    ],
    "tml_ci_regression": [
      "python",
      "tools/test_tml_ci.py",
      "-v"
    ],
    "env_poisoning": [
      "python",
      "-c",
      "import os; os.environ.update(INFINI_LOCAL_PORT='abc', INFINI_LLM_TIMEOUT_MS='xyz', INFINI_SPRITE_CACHE_MAX='garbage'); import infini_local.core.env_utils as e; print(e.env_int('INFINI_LOCAL_PORT', 9000)); print(e.env_int('INFINI_LLM_TIMEOUT_MS', 30000)); print(e.env_int('INFINI_SPRITE_CACHE_MAX', 512))"
    ]
  },
  "fullChecks": [
    "pytest",
    "compileall",
    "env_poisoning",
    "tml_ci_regression",
    "schema_check",
    "capability_audit",
    "generated_docs",
    "delivery_contract",
    "contract_parity",
    "mutation_gate",
    "planner_prompt",
    "semantic_runtime_diff",
    "runtime_impact",
    "csharp_contracts",
    "project_hygiene",
    "config_registry",
    "ruff",
    "pyright",
    "terraria_standardization",
    "targeted_repair",
    "lowery",
    "equipment_bounds",
    "primitive_parity",
    "handbook",
    "primitive_loss",
    "tml_build",
    "native_checks",
    "tml_runtime_selftest"
  ],
  "validationGroups": {
    "python": [
      "pytest",
      "compileall",
      "env_poisoning",
      "tml_ci_regression"
    ],
    "static": [
      "schema_check",
      "capability_audit",
      "generated_docs",
      "delivery_contract",
      "contract_parity",
      "mutation_gate",
      "planner_prompt",
      "semantic_runtime_diff",
      "runtime_impact",
      "csharp_contracts",
      "project_hygiene",
      "config_registry",
      "ruff",
      "pyright",
      "terraria_standardization",
      "targeted_repair",
      "lowery",
      "equipment_bounds",
      "primitive_parity",
      "handbook",
      "primitive_loss"
    ],
    "build": [
      "tml_build",
      "native_checks",
      "tml_runtime_selftest"
    ]
  },
  "refreshGroups": {
    "runtime": [
      [
        "python",
        "tools/export_contract_schemas.py"
      ],
      [
        "python",
        "tools/generate_equipment_bounds.py"
      ],
      [
        "python",
        "tools/generate_primitive_parity.py"
      ],
      [
        "python",
        "tools/generate_lowery.py"
      ],
      [
        "python",
        "tools/generate_low_level_runtime_docs.py"
      ],
      [
        "python",
        "tools/audit_targeted_repair.py",
        "--output",
        "contracts/targeted_repair_audit.generated.json"
      ],
      [
        "python",
        "tools/audit_terraria_standardization.py",
        "--write"
      ]
    ],
    "config": [
      [
        "python",
        "tools/config_registry.py"
      ]
    ],
    "docs": [
      [
        "python",
        "tools/build_documentation.py"
      ]
    ]
  }
}

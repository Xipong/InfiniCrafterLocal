{
  "schema": "infini.agent-impact-rules.v1",
  "rules": [
    {
      "id": "python-runtime-contract",
      "patterns": [
        "LocalGenerator/infini_local/core/runtime_authoring/**",
        "LocalGenerator/infini_local/core/runtime_contracts.py",
        "LocalGenerator/infini_local/qa/runtime_contract_replay.py",
        "LocalGenerator/tests/fixtures/runtime_contract_history/**",
        "tools/check_runtime_contract_replay.py",
        "tools/contract_parity.py",
        "tools/check_delivery_contract.py",
        "tools/mutation_contract_gate.py",
        "tools/semantic_runtime_diff.py",
        "tools/runtime_impact_report.py",
        "tools/check_planner_prompt_usability.py",
        "tools/export_contract_schemas.py",
        "LocalGenerator/infini_local/core/boundary_models.py",
        "LocalGenerator/infini_local/pipelines/combine_gameplay.py",
        "LocalGenerator/infini_local/pipelines/llm_authoring_*.py",
        "LocalGenerator/infini_local/storage/world_storage.py",
        "LocalGenerator/infini_local/core/strict_json.py",
        "LocalGenerator/infini_local/core/json_debug.py",
        "LocalGenerator/infini_local/core/runtime_promise_truth.py",
        "LocalGenerator/infini_local/pipelines/generation_debug.py",
        "LocalGenerator/infini_local/pipelines/pipeline_visual_config.py",
        "LocalGenerator/infini_local/services/combine_endpoint.py",
        "LocalGenerator/infini_local/services/sdcpp_service.py",
        "LocalGenerator/infini_local/web/server_handler.py",
        "LocalGenerator/infini_local/web/server_utility_routes.py"
      ],
      "checks": [
        "runtime_contract_tests",
        "schema_check",
        "contract_parity",
        "delivery_contract",
        "mutation_gate",
        "semantic_runtime_diff",
        "planner_prompt",
        "pyright",
        "historical_replay",
        "runtime_impact"
      ],
      "context": [
        "AGENTS.md",
        "docs/CONTRACT_SAFETY_STACK_RU.md",
        "LocalGenerator/infini_local/core/runtime_authoring/function_contract_registry.py",
        "LocalGenerator/infini_local/core/runtime_authoring/schema.py",
        "LocalGenerator/infini_local/core/boundary_models.py",
        "contracts/field_lifecycle.json",
        "LocalGenerator/infini_local/qa/csharp_delivery_contract.py",
        "LocalGenerator/infini_local/core/strict_json.py",
        "LocalGenerator/infini_local/core/json_debug.py"
      ]
    },
    {
      "id": "csharp-runtime-contract",
      "patterns": [
        "ModSources/**/*.cs",
        "ModSources/**/*.csproj",
        "Directory.Build.props",
        "global.json"
      ],
      "checks": [
        "pytest",
        "contract_parity",
        "delivery_contract",
        "mutation_gate",
        "semantic_runtime_diff",
        "csharp_contracts"
      ],
      "requiresBuild": true,
      "context": [
        "AGENTS.md",
        "docs/CONTRACT_SAFETY_STACK_RU.md",
        "ModSources/InfiniCrafterLocal/Common/Models/GeneratedItemData.Model.cs",
        "ModSources/InfiniCrafterLocal/Common/Models/GeneratedItemData.Normalize.cs",
        "ModSources/InfiniCrafterLocal/Content/Projectiles/GeneratedProjectile.NetSync.cs",
        "LocalGenerator/infini_local/qa/csharp_delivery_contract.py"
      ]
    },
    {
      "id": "network-protocol",
      "patterns": [
        "**/*NetSync*.cs",
        "**/*Packet*.cs",
        "**/*Network*.cs"
      ],
      "checks": [
        "contract_parity",
        "mutation_gate",
        "csharp_contracts"
      ],
      "requiresBuild": true,
      "context": [
        "ModSources/InfiniCrafterLocal/Content/Projectiles/GeneratedProjectile.NetSync.cs",
        "contracts/field_lifecycle.json"
      ]
    },
    {
      "id": "vfx-boundary",
      "patterns": [
        "LocalGenerator/infini_local/**/vfx*.py",
        "ModSources/**/Vfx*.cs",
        "contracts/schemas/vfx_manifest.schema.json"
      ],
      "checks": [
        "vfx_contract_tests",
        "schema_check",
        "contract_parity",
        "semantic_runtime_diff"
      ],
      "context": [
        "LocalGenerator/infini_local/core/boundary_models.py",
        "ModSources/InfiniCrafterLocal/Common/Models/VfxManifestSpec.cs"
      ]
    },
    {
      "id": "agent-tooling",
      "patterns": [
        ".agent/**",
        "tools/agentctl.py",
        "tools/validate_release.py",
        "tools/validate_sandbox.py",
        "tools/validate_release.sh",
        "tools/render_validation_report.py",
        "tools/run_changed_pytests.py",
        "tools/run_focused_pytests.py"
      ],
      "checks": [
        "agent_tooling_tests",
        "ruff",
        "pyright"
      ],
      "context": [
        "AGENTS.md",
        ".agent/manifest.json",
        ".agent/impact_rules.json",
        "LocalGenerator/infini_local/qa/csharp_delivery_contract.py"
      ]
    },
    {
      "id": "visual-authoring-contract",
      "patterns": [
        "LocalGenerator/infini_local/pipelines/visual_director_contract.py",
        "LocalGenerator/infini_local/pipelines/visual_generation_pipeline.py",
        "LocalGenerator/infini_local/pipelines/visual_prompt_contracts.py",
        "LocalGenerator/infini_local/pipelines/visual_asset_plan.py",
        "LocalGenerator/infini_local/pipelines/visual_sprite_generation.py",
        "LocalGenerator/infini_local/pipelines/visual_delivery_gate.py",
        "LocalGenerator/infini_local/services/visual_asset_pipeline.py",
        "contracts/schemas/visual_kit.schema.json"
      ],
      "checks": [
        "vfx_contract_tests",
        "schema_check",
        "project_hygiene",
        "ruff",
        "pyright"
      ],
      "context": [
        "AGENTS.md",
        "docs/RUNTIME_AUTHORING_CURRENT_RU.md",
        "LocalGenerator/infini_local/core/boundary_models.py",
        "LocalGenerator/infini_local/pipelines/visual_director_contract.py"
      ]
    },
    {
      "id": "configuration-surface",
      "patterns": [
        "LocalGenerator/config.example.env",
        "LocalGenerator/infini_local/**/config*.py",
        "LocalGenerator/infini_local/desktop/settings_schema.py",
        "**/*.py",
        "**/*.cs"
      ],
      "checks": [
        "config_registry"
      ],
      "context": [
        "contracts/config_registry.json",
        "LocalGenerator/config.example.env",
        "LocalGenerator/infini_local/desktop/settings_schema.py"
      ]
    },
    {
      "id": "tests-only",
      "patterns": [
        "LocalGenerator/tests/**"
      ],
      "checks": [
        "changed_pytests"
      ],
      "context": [
        "AGENTS.md"
      ]
    }
  ]
}

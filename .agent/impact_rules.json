{
  "schema": "infini.agent-impact-rules.v2",
  "rules": [
    {
      "id": "runtime-authoring-contract",
      "patterns": [
        "LocalGenerator/infini_local/core/runtime_authoring/**",
        "LocalGenerator/infini_local/pipelines/llm_authoring_*.py",
        "LocalGenerator/infini_local/pipelines/author_item_*.py",
        "contracts/schemas/runtime_program_*.json",
        "tools/audit_capability_library.py",
        "tools/contract_parity.py",
        "tools/check_delivery_contract.py",
        "tools/mutation_contract_gate.py",
        "tools/check_planner_prompt_usability.py",
        "LocalGenerator/infini_local/core/runtime_authoring/terraria_vocabulary.py",
        "lowery.md",
        "tools/audit_terraria_standardization.py"
      ],
      "checks": [
        "terraria_standardization",
        "capability_audit",
        "schema_check",
        "generated_docs",
        "delivery_contract",
        "contract_parity",
        "mutation_gate",
        "planner_prompt",
        "semantic_runtime_diff",
        "pytest"
      ],
      "context": [
        "AGENTS.md",
        "docs/LOW_LEVEL_RUNTIME_AUTHORING_RU.md",
        "docs/ADDING_RUNTIME_CAPABILITY_FOR_AGENTS_RU.md",
        "docs/TECHNICAL_LOWERING_POLICY_RU.md",
        "LocalGenerator/infini_local/core/runtime_authoring/capability_registry.py",
        "lowery.md",
        "docs/TERRARIA_TMODLOADER_STANDARDIZATION_RU.md"
      ]
    },
    {
      "id": "csharp-runtime-contract",
      "patterns": [
        "ModSources/InfiniCrafterLocal/Common/Models/RuntimeProgramSpec.cs",
        "ModSources/InfiniCrafterLocal/Common/Models/GeneratedItemData*.cs",
        "ModSources/InfiniCrafterLocal/Common/Runtime/**",
        "ModSources/InfiniCrafterLocal/Content/Items/GeneratedItem*.cs",
        "ModSources/InfiniCrafterLocal/Content/Projectiles/GeneratedProjectile*.cs",
        "ModSources/InfiniCrafterLocal/**/*.csproj",
        "ModSources/InfiniCrafterLocal/Common/Models/TerrariaRuntimeVocabulary.cs"
      ],
      "checks": [
        "terraria_standardization",
        "delivery_contract",
        "contract_parity",
        "mutation_gate",
        "semantic_runtime_diff",
        "csharp_contracts",
        "tml_build"
      ],
      "requiresBuild": true,
      "context": [
        "docs/LOW_LEVEL_CAPABILITY_INVENTORY_RU.md",
        "ModSources/InfiniCrafterLocal/Common/Models/RuntimeProgramSpec.cs",
        "ModSources/InfiniCrafterLocal/Content/Projectiles/GeneratedProjectile.NetSync.cs",
        "lowery.md"
      ]
    },
    {
      "id": "visual-vfx-boundary",
      "patterns": [
        "LocalGenerator/infini_local/pipelines/visual_*.py",
        "LocalGenerator/infini_local/core/vfx_manifest.py",
        "ModSources/InfiniCrafterLocal/Common/VFX/**",
        "ModSources/InfiniCrafterLocal/Common/Models/VfxManifestSpec.cs"
      ],
      "checks": [
        "schema_check",
        "contract_parity",
        "semantic_runtime_diff",
        "pytest"
      ],
      "context": [
        "docs/THREE_STAGE_LLM_PIPELINE_RU.md",
        "docs/LOW_LEVEL_RUNTIME_AUTHORING_RU.md"
      ]
    },
    {
      "id": "storage-network-boundary",
      "patterns": [
        "LocalGenerator/infini_local/storage/**",
        "ModSources/InfiniCrafterLocal/**/*NetSync*.cs",
        "ModSources/InfiniCrafterLocal/**/*Packet*.cs"
      ],
      "checks": [
        "delivery_contract",
        "csharp_contracts",
        "project_hygiene",
        "pytest",
        "tml_build"
      ],
      "requiresBuild": true,
      "context": [
        "PROJECT_ARCHITECTURE_RU.md",
        "docs/LOW_LEVEL_RUNTIME_AUTHORING_RU.md"
      ]
    }
  ]
}

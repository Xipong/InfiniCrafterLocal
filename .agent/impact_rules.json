{
  "schema": "infini.agent-impact-rules.v3",
  "rules": [
    {
      "id": "runtime-authoring-contract",
      "patterns": [
        "generator/infini_local/core/runtime_authoring/**",
        "contracts/schemas/runtime_program_*.json",
        "tools/checks/audit_capability_library.py",
        "tools/checks/check_planner_prompt_usability.py",
        "generator/infini_local/core/runtime_authoring/terraria_vocabulary.py",
        "docs/reference/generated/LOWERY_RU.md",
        "generator/infini_local/pipelines/author/stage.py",
        "generator/infini_local/pipelines/author/**"
      ],
      "checks": [
        "schema_check"
      ],
      "context": [
        "docs/reference/authoring/LOW_LEVEL_RUNTIME_AUTHORING_RU.md",
        "docs/development/ADDING_RUNTIME_CAPABILITY_FOR_AGENTS_RU.md",
        "docs/development/architecture/TECHNICAL_LOWERING_POLICY_RU.md",
        "generator/infini_local/core/runtime_authoring/capability_registry.py",
        "docs/reference/generated/LOWERY_RU.md",
        "docs/reference/terraria/TERRARIA_TMODLOADER_STANDARDIZATION_RU.md"
      ],
      "area": "runtime",
      "tests": [
        "tests/generator/**/test_registry_*contract.py",
        "tests/generator/authoring/test_repair_gameplay_contract.py",
        "tests/generator/authoring/test_low_level_three_stage_pipeline.py",
        "tests/generator/authoring/test_repair_frozen_contract.py",
        "tests/generator/authoring/test_repair_structure_unions.py",
        "tests/generator/authoring/test_gameplay_repair_readonly_context.py",
        "tests/generator/authoring/test_repair_diagnostic_composition.py"
      ],
      "entrypoints": [
        "generator/infini_local/pipelines/author/stage.py",
        "generator/infini_local/AGENTS.md",
        "docs/development/ADDING_RUNTIME_CAPABILITY_FOR_AGENTS_RU.md",
        "generator/infini_local/core/runtime_authoring/capability_registry.py"
      ]
    },
    {
      "id": "csharp-runtime-contract",
      "patterns": [
        "mod/**/*.cs",
        "mod/**/*.csproj",
        "tests/native/**/EngineRuntimeChecks*.cs",
        "tests/native/EngineRuntimeChecks.csproj",
        "Directory.Build.props",
        "global.json"
      ],
      "checks": [
        "csharp_contracts",
        "native_checks"
      ],
      "requiresBuild": true,
      "context": [
        "docs/reference/generated/LOW_LEVEL_CAPABILITY_INVENTORY_RU.md",
        "mod/InfiniCrafterLocal/Common/Models/Contracts/RuntimeProgramSpec.cs",
        "mod/InfiniCrafterLocal/Content/Projectiles/Networking/GeneratedProjectile.NetSync.cs",
        "docs/reference/generated/LOWERY_RU.md"
      ],
      "area": "native",
      "entrypoints": [
        "mod/InfiniCrafterLocal/Common/Runtime/RuntimeProgramExecutor.cs",
        "mod/InfiniCrafterLocal/AGENTS.md",
        "docs/development/CODE_MAP_RU.md"
      ]
    },
    {
      "id": "visual-vfx-boundary",
      "patterns": [
        "generator/infini_local/pipelines/visual/**",
        "generator/infini_local/pipelines/images/**",
        "generator/infini_local/core/images/**",
        "mod/InfiniCrafterLocal/Common/VFX/**",
        "mod/InfiniCrafterLocal/Common/Models/Presentation/VfxManifestSpec.cs",
        "generator/infini_local/core/vfx/**",
        "generator/infini_local/pipelines/vfx/**"
      ],
      "checks": [
        "schema_check"
      ],
      "context": [
        "docs/development/pipeline/THREE_STAGE_LLM_PIPELINE_RU.md",
        "docs/reference/authoring/LOW_LEVEL_RUNTIME_AUTHORING_RU.md"
      ],
      "area": "visual",
      "tests": [
        "tests/generator/vfx/test_repair_vfx_contract.py",
        "tests/generator/vfx/test_vfx_dependency_delivery_contracts.py",
        "tests/generator/runtime/test_docx_image_readiness.py",
        "tests/generator/vfx/test_visual_presentation_metadata.py"
      ],
      "entrypoints": [
        "generator/infini_local/AGENTS.md",
        "generator/infini_local/pipelines/visual/stage.py",
        "generator/infini_local/core/vfx/schema.py"
      ]
    },
    {
      "id": "storage-network-boundary",
      "patterns": [
        "generator/infini_local/storage/**",
        "generator/infini_local/pipelines/combine_pipeline.py"
      ],
      "checks": [],
      "requiresBuild": false,
      "context": [
        "docs/development/architecture/ARCHITECTURE_RU.md",
        "docs/reference/authoring/LOW_LEVEL_RUNTIME_AUTHORING_RU.md"
      ],
      "area": "storage",
      "tests": [
        "tests/generator/storage/test_world_recipe_cache_admission.py",
        "tests/generator/authoring/test_generation_resume.py",
        "tests/generator/images/test_asset_transfer_cache_contracts.py",
        "tests/generator/authoring/test_registry_composition_contract.py"
      ],
      "entrypoints": [
        "generator/infini_local/AGENTS.md",
        "generator/infini_local/storage/world_storage.py"
      ]
    },
    {
      "id": "finite-llm-stages",
      "patterns": [
        "generator/infini_local/core/llm_stage_messages.py"
      ],
      "checks": [
        "project_hygiene"
      ],
      "context": [
        "docs/development/pipeline/THREE_STAGE_LLM_PIPELINE_RU.md"
      ],
      "area": "transport",
      "tests": [
        "tests/generator/authoring/test_low_level_three_stage_pipeline.py",
        "tests/generator/vfx/test_visual_vfx_prompt_prefix.py"
      ],
      "entrypoints": [
        "generator/infini_local/core/llm_stage_messages.py"
      ]
    },
    {
      "id": "shared-llm-boundaries",
      "patterns": [
        "generator/infini_local/core/llm_json_tools.py",
        "generator/infini_local/core/provider_schema.py",
        "generator/infini_local/core/schema_validation.py",
        "generator/infini_local/pipelines/transport/**"
      ],
      "checks": [
        "project_hygiene"
      ],
      "context": [
        "docs/development/pipeline/THREE_STAGE_LLM_PIPELINE_RU.md"
      ],
      "area": "transport",
      "tests": [
        "tests/generator/**/test_provider_*contract.py",
        "tests/generator/authoring/test_repair_frozen_contract.py",
        "tests/generator/authoring/test_registry_vertical_contract.py",
        "tests/generator/providers/test_codex_subscription_contract.py",
        "tests/generator/providers/test_codex_transport_trace.py",
        "tests/generator/providers/test_codex_static_instruction_prefix.py",
        "tests/generator/runtime/test_transport_retry_redaction.py",
        "tests/generator/providers/test_llm_auth_diagnostics_contract.py"
      ],
      "entrypoints": [
        "generator/infini_local/AGENTS.md",
        "generator/infini_local/pipelines/transport/client.py"
      ]
    },
    {
      "id": "codex-native-transport",
      "area": "transport",
      "patterns": [
        "generator/infini_local/services/codex_auth.py",
        "generator/infini_local/services/codex_text_backend.py",
        "generator/infini_local/services/codex_image_backend.py"
      ],
      "checks": [
        "project_hygiene"
      ],
      "tests": [
        "tests/generator/providers/test_codex_subscription_contract.py",
        "tests/generator/providers/test_codex_transport_trace.py",
        "tests/generator/providers/test_codex_static_instruction_prefix.py",
        "tests/generator/providers/test_codex_trace_boundaries.py",
        "tests/generator/images/test_image_transport_join.py",
        "tests/generator/runtime/test_transport_retry_redaction.py",
        "tests/generator/providers/test_llm_auth_diagnostics_contract.py"
      ],
      "entrypoints": [
        "generator/infini_local/services/codex_text_backend.py",
        "generator/infini_local/services/codex_auth.py",
        "generator/infini_local/AGENTS.md"
      ],
      "context": [
        "docs/development/CODE_MAP_RU.md"
      ]
    },
    {
      "id": "studio-settings",
      "area": "studio",
      "patterns": [
        "generator/infini_local/desktop/**",
        "generator/settings_gui.py",
        "generator/config.example.env"
      ],
      "checks": [
        "config_registry"
      ],
      "tests": [
        "tests/generator/**/test_web_studio*.py",
        "tests/generator/**/test_settings_*.py",
        "tests/generator/**/test_studio_*.py",
        "tests/generator/providers/test_openrouter_provider_settings.py"
      ],
      "entrypoints": [
        "generator/infini_local/desktop/web_studio.py",
        "generator/infini_local/desktop/settings_schema.py"
      ],
      "context": [
        "docs/development/TESTING_RU.md"
      ]
    },
    {
      "id": "offline-support-bundle",
      "area": "tooling",
      "patterns": [
        "tools/diagnostics/export_support_bundle.py",
        "tests/generator/runtime/test_support_bundle.py"
      ],
      "checks": [
        "project_hygiene"
      ],
      "tests": [
        "tests/generator/runtime/test_support_bundle.py"
      ],
      "entrypoints": [
        "tools/diagnostics/export_support_bundle.py"
      ],
      "context": [
        "docs/user/DIAGNOSTICS_RU.md"
      ]
    },
    {
      "id": "offline-craft-audit",
      "area": "tooling",
      "patterns": [
        "tools/craft-audit/**",
        "tests/toolbox/test_craft_audit.py"
      ],
      "checks": [
        "project_hygiene",
        "schema_check"
      ],
      "tests": [
        "tests/toolbox/test_craft_audit.py"
      ],
      "entrypoints": [
        "tools/craft-audit/audit.py",
        "tools/craft-audit/README_RU.md"
      ],
      "context": []
    },
    {
      "id": "development-workflow",
      "area": "tooling",
      "patterns": [
        "tools/agentctl.py",
        "tools/testing/run_changed_pytests.py",
        "tools/testing/run_focused_pytests.py",
        "tools/testing/run_pytest_shards.py",
        "tools/validate_release.py",
        "tools/build/validate_release*",
        "tools/diagnostics/render_validation_report.py",
        ".agent/**",
        ".github/workflows/ci.yml",
        "tools/checks/check_code_health.py"
      ],
      "checks": [
        "project_hygiene"
      ],
      "tests": [
        "tests/generator/tooling/test_pytest_runner_selection.py",
        "tests/generator/tooling/test_code_health.py"
      ],
      "entrypoints": [
        "docs/development/TESTING_RU.md",
        "tools/agentctl.py"
      ],
      "context": []
    },
    {
      "id": "handbook",
      "area": "docs",
      "patterns": [
        "docs/**",
        "tools/README_RU.md",
        "AGENTS.md",
        "**/AGENTS.md",
        "README.md",
        "CONTRIBUTING.md",
        "START_HERE.html",
        ".aiignore",
        ".cursorignore"
      ],
      "checks": [
        "handbook",
        "project_hygiene"
      ],
      "entrypoints": [
        "docs/development/CODE_MAP_RU.md"
      ],
      "context": []
    },
    {
      "id": "tml-build-workflow",
      "area": "tooling",
      "patterns": [
        "tools/testing/test_tml_ci.py",
        "tools/build/build_tml_windows.*",
        "tools/build/parse_tml_build_log.py"
      ],
      "checks": [
        "tml_ci_regression"
      ],
      "entrypoints": [
        "tools/testing/test_tml_ci.py"
      ],
      "context": [
        "docs/development/BUILD_RU.md"
      ]
    },
    {
      "id": "item-test-workbench",
      "area": "tooling",
      "patterns": [
        "tools/workbench/**"
      ],
      "checks": [
        "item_workbench_python",
        "item_workbench_build"
      ],
      "entrypoints": [
        "tools/workbench/README.md",
        "tools/workbench/workbench.py"
      ],
      "context": [
        "tools/workbench/SUPPORT_MATRIX.md"
      ]
    }
  ]
}

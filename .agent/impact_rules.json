{
  "schema": "infini.agent-impact-rules.v3",
  "rules": [
    {
      "id": "runtime-authoring-contract",
      "patterns": [
        "LocalGenerator/infini_local/core/runtime_authoring/**",
        "LocalGenerator/infini_local/pipelines/llm_authoring_*.py",
        "LocalGenerator/infini_local/pipelines/author_item_*.py",
        "contracts/schemas/runtime_program_*.json",
        "tools/audit_capability_library.py",
        "tools/contract_parity.py",
        "tools/check_delivery_contract.py",
        "tools/mutation_contract_gate.py",
        "tools/check_planner_prompt_usability.py",
        "LocalGenerator/infini_local/core/runtime_authoring/terraria_vocabulary.py",
        "docs/reference/generated/LOWERY_RU.md",
        "tools/audit_terraria_standardization.py",
        "LocalGenerator/infini_local/pipelines/gameplay_stage.py"
      ],
      "checks": [
        "schema_check",
        "delivery_contract"
      ],
      "context": [
        "docs/reference/LOW_LEVEL_RUNTIME_AUTHORING_RU.md",
        "docs/development/ADDING_RUNTIME_CAPABILITY_FOR_AGENTS_RU.md",
        "docs/development/TECHNICAL_LOWERING_POLICY_RU.md",
        "LocalGenerator/infini_local/core/runtime_authoring/capability_registry.py",
        "docs/reference/generated/LOWERY_RU.md",
        "docs/reference/TERRARIA_TMODLOADER_STANDARDIZATION_RU.md"
      ],
      "area": "runtime",
      "tests": [
        "LocalGenerator/tests/test_registry_*contract.py",
        "LocalGenerator/tests/test_repair_gameplay_contract.py",
        "LocalGenerator/tests/test_low_level_three_stage_pipeline.py"
      ],
      "entrypoints": [
        "LocalGenerator/infini_local/AGENTS.md",
        "docs/development/ADDING_RUNTIME_CAPABILITY_FOR_AGENTS_RU.md",
        "LocalGenerator/infini_local/core/runtime_authoring/capability_registry.py"
      ]
    },
    {
      "id": "csharp-runtime-contract",
      "patterns": [
        "ModSources/**/*.cs",
        "ModSources/**/*.csproj",
        "tools/EngineRuntimeChecks*.cs",
        "tools/EngineRuntimeChecks.csproj",
        "Directory.Build.props",
        "global.json"
      ],
      "checks": [
        "csharp_contracts",
        "native_checks"
      ],
      "requiresBuild": true,
      "context": [
        "docs/reference/generated/LOW_LEVEL_CAPABILITY_INVENTORY_RU.md",
        "ModSources/InfiniCrafterLocal/Common/Models/Contracts/RuntimeProgramSpec.cs",
        "ModSources/InfiniCrafterLocal/Content/Projectiles/GeneratedProjectile.NetSync.cs",
        "docs/reference/generated/LOWERY_RU.md"
      ],
      "area": "native",
      "entrypoints": [
        "ModSources/InfiniCrafterLocal/AGENTS.md",
        "docs/development/CODE_MAP_RU.md"
      ]
    },
    {
      "id": "visual-vfx-boundary",
      "patterns": [
        "LocalGenerator/infini_local/pipelines/visual_*.py",
        "LocalGenerator/infini_local/core/vfx_manifest.py",
        "ModSources/InfiniCrafterLocal/Common/VFX/**",
        "ModSources/InfiniCrafterLocal/Common/Models/Presentation/VfxManifestSpec.cs",
        "LocalGenerator/infini_local/pipelines/vfx_generation_pipeline.py"
      ],
      "checks": [
        "schema_check"
      ],
      "context": [
        "docs/development/THREE_STAGE_LLM_PIPELINE_RU.md",
        "docs/reference/LOW_LEVEL_RUNTIME_AUTHORING_RU.md"
      ],
      "area": "visual",
      "tests": [
        "LocalGenerator/tests/test_repair_vfx_contract.py",
        "LocalGenerator/tests/test_vfx_dependency_delivery_contracts.py",
        "LocalGenerator/tests/test_visual_presentation_metadata.py"
      ],
      "entrypoints": [
        "LocalGenerator/infini_local/AGENTS.md",
        "LocalGenerator/infini_local/pipelines/visual_generation_pipeline.py",
        "LocalGenerator/infini_local/core/vfx_manifest.py"
      ]
    },
    {
      "id": "storage-network-boundary",
      "patterns": [
        "LocalGenerator/infini_local/storage/**"
      ],
      "checks": [
        "delivery_contract"
      ],
      "requiresBuild": false,
      "context": [
        "docs/development/ARCHITECTURE_RU.md",
        "docs/reference/LOW_LEVEL_RUNTIME_AUTHORING_RU.md"
      ],
      "area": "storage",
      "tests": [
        "LocalGenerator/tests/test_world_recipe_cache_admission.py",
        "LocalGenerator/tests/test_asset_transfer_cache_contracts.py"
      ],
      "entrypoints": [
        "LocalGenerator/infini_local/AGENTS.md",
        "LocalGenerator/infini_local/storage/world_storage.py"
      ]
    },
    {
      "id": "shared-llm-boundaries",
      "patterns": [
        "LocalGenerator/infini_local/core/llm_json_tools.py",
        "LocalGenerator/infini_local/core/schema_validation.py",
        "LocalGenerator/infini_local/pipelines/llm_transport.py"
      ],
      "checks": [
        "project_hygiene"
      ],
      "context": [
        "docs/development/THREE_STAGE_LLM_PIPELINE_RU.md"
      ],
      "area": "transport",
      "tests": [
        "LocalGenerator/tests/test_provider_*contract.py",
        "LocalGenerator/tests/test_repair_frozen_contract.py",
        "LocalGenerator/tests/test_registry_vertical_contract.py"
      ],
      "entrypoints": [
        "LocalGenerator/infini_local/AGENTS.md",
        "LocalGenerator/infini_local/pipelines/llm_transport.py"
      ]
    },
    {
      "id": "studio-settings",
      "area": "studio",
      "patterns": [
        "LocalGenerator/infini_local/desktop/**",
        "LocalGenerator/settings_gui.py",
        "LocalGenerator/config.example.env"
      ],
      "checks": [
        "config_registry"
      ],
      "tests": [
        "LocalGenerator/tests/test_web_studio*.py",
        "LocalGenerator/tests/test_settings_*.py",
        "LocalGenerator/tests/test_studio_*.py",
        "LocalGenerator/tests/test_openrouter_provider_settings.py"
      ],
      "entrypoints": [
        "LocalGenerator/infini_local/desktop/web_studio.py",
        "LocalGenerator/infini_local/desktop/settings_schema.py"
      ],
      "context": [
        "docs/development/TESTING_RU.md"
      ]
    },
    {
      "id": "development-workflow",
      "area": "tooling",
      "patterns": [
        "tools/agentctl.py",
        "tools/run_changed_pytests.py",
        "tools/run_focused_pytests.py",
        "tools/run_pytest_shards.py",
        "tools/validate_release*",
        "tools/render_validation_report.py",
        ".agent/**",
        ".github/workflows/ci.yml"
      ],
      "checks": [
        "project_hygiene"
      ],
      "tests": [
        "LocalGenerator/tests/test_pytest_runner_selection.py"
      ],
      "entrypoints": [
        "docs/development/TESTING_RU.md",
        "tools/agentctl.py"
      ],
      "context": []
    },
    {
      "id": "handbook",
      "area": "docs",
      "patterns": [
        "docs/**",
        "AGENTS.md",
        "**/AGENTS.md",
        "README.md",
        "CONTRIBUTING.md",
        "START_HERE.html"
      ],
      "checks": [
        "handbook",
        "project_hygiene"
      ],
      "entrypoints": [
        "docs/development/CODE_MAP_RU.md"
      ],
      "context": []
    },
    {
      "id": "tml-build-workflow",
      "area": "tooling",
      "patterns": [
        "tools/test_tml_ci.py",
        "tools/build_tml_windows.*",
        "tools/parse_tml_build_log.py"
      ],
      "checks": [
        "tml_ci_regression"
      ],
      "entrypoints": [
        "tools/test_tml_ci.py"
      ],
      "context": [
        "docs/development/BUILD_RU.md"
      ]
    }
  ]
}

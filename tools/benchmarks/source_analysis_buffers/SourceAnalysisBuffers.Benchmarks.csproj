<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RuntimeFrameworkVersion>8.0.0</RuntimeFrameworkVersion>
    <UseAppHost>false</UseAppHost>
    <RollForward>Disable</RollForward>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../mod/InfiniCrafterLocal/Common/Analysis/SourceAnalysisBuffers.cs" Link="SourceAnalysisBuffers.cs" />
    <EmbeddedResource Include="../../../mod/InfiniCrafterLocal/Common/Analysis/SourceAnalysisBuffers.cs" LogicalName="SourceAnalysisBuffers.source.cs" />
    <EmbeddedResource Include="Program.cs" LogicalName="Benchmark.source.cs" />
    <EmbeddedResource Include="SourceAnalysisBuffers.Benchmarks.csproj" LogicalName="Benchmark.project.xml" />
  </ItemGroup>
</Project>

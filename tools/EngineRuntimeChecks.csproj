    <Compile Include="EngineRuntimeChecks.Vfx.cs" />
    <Compile Include="EngineRuntimeChecks.Client.cs" />
    <Compile Include="EngineRuntimeChecks.Contract.cs" />
    <Compile Include="EngineRuntimeChecks.BuffPrecision.cs" />
    <Compile Include="EngineRuntimeChecks.LiteralStackCost.cs" />
    <Compile Include="EngineRuntimeChecks.StackChance.cs" />
    <Compile Include="EngineRuntimeChecks.Float32BuffIdentity.cs" />
    <Compile Include="EngineRuntimeChecks.UtilityBuffUI.cs" />
    <Compile Include="EngineRuntimeChecks.UtilityBuffDraw.cs" />
    <Compile Include="EngineRuntimeChecks.PlacedBody.cs" />
    <Compile Include="EngineRuntimeChecks.PlacedBodyLedger.cs" />

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InfiniModSourceRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../ModSources/InfiniCrafterLocal'))</InfiniModSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile the canonical implementation, never a copied/extracted method. -->
    <Compile Include="$(InfiniModSourceRoot)/**/*.cs" Exclude="$(InfiniModSourceRoot)/obj/**;$(InfiniModSourceRoot)/bin/**" />
    <Compile Include="EngineRuntimeChecks.cs" />
    <Compile Include="EngineRuntimeChecks.HitboxCurve.cs" />
    <Compile Include="EngineRuntimeChecks.Modifiers.cs" />
    <Compile Include="EngineRuntimeChecks.RawJsonNumeric.cs" />

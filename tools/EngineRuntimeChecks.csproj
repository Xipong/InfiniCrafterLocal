    <Compile Include="EngineRuntimeChecks.CursorInstance.cs" />
    <Compile Include="EngineRuntimeChecks.QuickUse.cs" />
    <Compile Include="EngineRuntimeChecks.QuickUtilityActivation.cs" />
    <Compile Include="EngineRuntimeChecks.Grounded.cs" />
    <Compile Include="EngineRuntimeChecks.PresentationMetadata.cs" />
    <Compile Include="EngineRuntimeChecks.ItemDraw.cs" />
    <Compile Include="EngineRuntimeChecks.SpriteAlpha.cs" />
    <Compile Include="EngineRuntimeChecks.EquipPresentation.cs" />
    <Compile Include="EngineRuntimeChecks.VfxEventConsistency.cs" />
    <Compile Include="EngineRuntimeChecks.SoundSelection.cs" />
    <Compile Include="EngineRuntimeChecks.VfxGeometry.cs" />
    <Compile Include="EngineRuntimeChecks.MaterialElements.cs" />

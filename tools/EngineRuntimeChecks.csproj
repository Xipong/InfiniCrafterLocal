<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InfiniModSourceRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../ModSources/InfiniCrafterLocal'))</InfiniModSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile the canonical implementation, never a copied/extracted method. -->
    <Compile Include="$(InfiniModSourceRoot)/**/*.cs" Exclude="$(InfiniModSourceRoot)/obj/**;$(InfiniModSourceRoot)/bin/**" />
    <Compile Include="EngineRuntimeChecks.cs" />
    <Compile Include="EngineRuntimeChecks.World.cs" />
    <Compile Include="EngineRuntimeChecks.Player.cs" />
    <Compile Include="EngineRuntimeChecks.Vfx.cs" />
    <Compile Include="EngineRuntimeChecks.Client.cs" />
    <Compile Include="EngineRuntimeChecks.Contract.cs" />
    <Compile Include="EngineRuntimeChecks.Equipment.cs" />
    <Compile Include="EngineRuntimeChecks.Ammo.cs" />
    <Compile Include="EngineRuntimeChecks.Whip.cs" />
    <Compile Include="EngineRuntimeChecks.Proximity.cs" />
    <Compile Include="EngineRuntimeChecks.BudgetPeer.cs" />
    <Compile Include="EngineRuntimeChecks.RootSpawn.cs" />
    <Compile Include="EngineRuntimeChecks.Assets.cs" />
    <Compile Include="EngineRuntimeChecks.Events.cs" />
    <Compile Include="EngineRuntimeChecks.Mobility.cs" />
    <Reference Include="$(InfiniTmlReferenceDir)/*.dll" />
    <Reference Include="$(InfiniExternalDepsRoot)/ParticleLibrary/ParticleLibrary.dll" />
    <Reference Include="$(InfiniExternalDepsRoot)/Luminance/bin/Debug/net8.0/Luminance.dll" />
  </ItemGroup>
  <Target Name="ValidateEngineCheckReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(InfiniTmlReferenceDir)' == '' Or !Exists('$(InfiniTmlReferenceDir)/tModLoader.dll')" Text="Set InfiniTmlReferenceDir to the existing tModLoader package lib/net8.0 directory." />
    <Error Condition="'$(InfiniExternalDepsRoot)' == '' Or !Exists('$(InfiniExternalDepsRoot)/ParticleLibrary/ParticleLibrary.dll') Or !Exists('$(InfiniExternalDepsRoot)/Luminance/bin/Debug/net8.0/Luminance.dll')" Text="Set InfiniExternalDepsRoot to the existing ParticleLibrary/Luminance dependency root." />
  </Target>
</Project>

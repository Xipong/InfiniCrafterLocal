<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable><AllowUnsafeBlocks>true</AllowUnsafeBlocks><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <StartupObject>WorkbenchProgram</StartupObject>
    <InfiniModSourceRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../ModSources/InfiniCrafterLocal'))</InfiniModSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(InfiniModSourceRoot)/Assets/GeneratedProjectile.png" Link="native-assets/GeneratedProjectile.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(InfiniModSourceRoot)/Assets/GeneratedItem.png" Link="native-assets/GeneratedItem.png" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="$(InfiniModSourceRoot)/**/*.cs" Exclude="$(InfiniModSourceRoot)/obj/**;$(InfiniModSourceRoot)/bin/**" />
    <Compile Include="../native/EngineRuntimeChecks*.cs" /><Compile Include="*.cs" />
    <Reference Include="$(InfiniTmlReferenceDir)/*.dll" />
    <Reference Include="$(InfiniExternalDepsRoot)/ParticleLibrary/ParticleLibrary.dll" />
    <Reference Include="$(InfiniExternalDepsRoot)/Luminance/bin/Debug/net8.0/Luminance.dll" />
  </ItemGroup>
  <Target Name="ValidateReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(InfiniTmlReferenceDir)/tModLoader.dll')" Text="Set InfiniTmlReferenceDir to existing tModLoader reference directory." />
    <Error Condition="!Exists('$(InfiniExternalDepsRoot)/ParticleLibrary/ParticleLibrary.dll') Or !Exists('$(InfiniExternalDepsRoot)/Luminance/bin/Debug/net8.0/Luminance.dll')" Text="Set InfiniExternalDepsRoot to existing ParticleLibrary/Luminance root." />
  </Target>
</Project>

{
  "name": "Surveyor's Returning Pick",
  "category": "tool",
  "concept": {
    "literalSynthesis": "A compact mining pick paired with a crescent-shaped returning tool, combining the synthetic brief's miner's implement and boomerang identity into one ore-surveying tool.",
    "coreMechanic": "Use the pick to mine while launching one straight damaging survey bolt; alternate use sends one damaging crescent that returns toward its owner. While the item is selected and held, its named generated effect group is refreshed with native ore highlighting and modest life regeneration. Both launches are reusable and isolated to their own input. The packet supplies no actual parent stats, acquisition tier, or resource cost facts, so these bounded values are authored choices rather than inherited observations.",
    "parentAContribution": "The synthetic context supplies a mining-tool identity, represented by the positive pick power and the pick-shaped item body. It provides no observed parent appearance, damage, tempo, or progression facts.",
    "parentBContribution": "The synthetic context supplies a boomerang-like returning identity, represented by the alternate crescent projectile. Its returning behavior and numeric values are authored mechanics, not observed parent abilities.",
    "playerExperience": "Primary use mines and fires the straight bolt; alternate use fires the returning crescent. Holding the selected item maintains ore highlighting and 1 HP/s regeneration. Reuse is free, with modest projectile damage and finite projectile lifetimes.",
    "plannedPlayerActions": [
      {
        "input": "primary_use",
        "intent": "Mine with the pick and launch one straight damaging projectile, without launching the returning crescent."
      },
      {
        "input": "alternate_use",
        "intent": "Launch one damaging boomerang-like projectile that returns toward its owner, without launching the straight projectile."
      },
      {
        "input": "passive_or_event",
        "intent": "While the item is selected and held, refresh its named generated effect group for ore highlighting and modest life regeneration."
      }
    ]
  },

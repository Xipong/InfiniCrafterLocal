{
  "outputContract": {
    "assetDemandRule": "A role prompt describes appearance but never requests a PNG by itself; only bakedAssets.<role>.mode=baked_sprite requests one.",
    "bakedAssetRoleKeys": [
      "projectile",
      "impact",
      "child",
      "field",
      "equip_overlay"
    ],
    "fieldPlacementRule": "Role prompt and VFX fields belong directly inside visualKit; never inside bakedAssets and never inside a vfx object. Each bakedAssets role object contains only mode, reason, and projectile-only distinctFromItem.",
    "forbiddenBakedAssetKeys": [
      "item",
      "vfx"
    ],
    "roleFields": {
      "child": {
        "assetModeField": "bakedAssets.child.mode",
        "promptField": "childSpritePrompt",
        "requiredWhen": "the accepted runtime has a child role; a non-empty prompt is mandatory when mode=baked_sprite"
      },
      "equip_overlay": {
        "assetModeField": "bakedAssets.equip_overlay.mode",
        "promptField": "equipOverlayPrompt",
        "requiredWhen": "resultKind is armor or accessory; author one transparent single-pose overlay emblem, not an armor sheet or inventory icon"
      },
      "field": {
        "assetModeField": "bakedAssets.field.mode",
        "promptField": "fieldSpritePrompt",
        "requiredWhen": "the accepted runtime has a field role; a non-empty prompt is mandatory when mode=baked_sprite"
      },
      "impact": {
        "assetModeField": "bakedAssets.impact.mode",
        "promptField": "impactSpritePrompt",
        "requiredWhen": "the role is visually relevant; a non-empty prompt is mandatory when mode=baked_sprite"
      },
      "item": {
        "assetDecision": "the item icon is always the required generated inventory/held sprite; it is never represented by a bakedAssets.item entry",
        "promptField": "itemIconPrompt",
        "requiredWhen": "always"
      },
      "projectile": {
        "assetModeField": "bakedAssets.projectile.mode",
        "promptField": "projectileSpritePrompt",
        "requiredWhen": "the role is visually relevant; a non-empty prompt is mandatory when mode=baked_sprite"
      }
    },
    "rootKey": "visualKit",
    "rootRule": "The root object must contain exactly one key named \"visualKit\". Never return itemIconPrompt, bakedAssets, or any other VisualKit field at the root."
  },

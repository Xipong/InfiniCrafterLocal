<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InfiniModSourceRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../mod/InfiniCrafterLocal'))</InfiniModSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile the canonical implementation, never a copied/extracted method. -->
    <Compile Include="$(InfiniModSourceRoot)/**/*.cs" Exclude="$(InfiniModSourceRoot)/obj/**;$(InfiniModSourceRoot)/bin/**" />
    <!-- Source discovery is automatic; RunChecks still explicitly registers execution. -->
    <Compile Include="**/EngineRuntimeChecks*.cs" Exclude="**/obj/**;**/bin/**" />
    <Reference Include="ICSharpCode.Decompiler" HintPath="$(InfiniModSourceRoot)/lib/ICSharpCode.Decompiler.dll" />
    <Content Include="$(InfiniModSourceRoot)/lib/ICSharpCode.Decompiler.LICENSE.txt" Link="ICSharpCode.Decompiler.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(InfiniModSourceRoot)/Data/native-source-pack.zip" Link="Data/native-source-pack.zip"
             CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(InfiniModSourceRoot)/Data/native-source-pack.zip')" />
    <EmbeddedResource Include="fixtures/AtlasMouseTextMetrics.json" />
    <Reference Include="$(InfiniTmlReferenceDir)/*.dll" />
    <Reference Include="$(InfiniExternalDepsRoot)/ParticleLibrary/ParticleLibrary.dll" />
    <Reference Include="$(InfiniExternalDepsRoot)/Luminance/bin/Debug/net8.0/Luminance.dll" />
  </ItemGroup>
  <Target Name="ValidateEngineCheckReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(InfiniTmlReferenceDir)' == '' Or !Exists('$(InfiniTmlReferenceDir)/tModLoader.dll')" Text="Set InfiniTmlReferenceDir to the existing tModLoader package lib/net8.0 directory." />
    <Error Condition="'$(InfiniExternalDepsRoot)' == '' Or !Exists('$(InfiniExternalDepsRoot)/ParticleLibrary/ParticleLibrary.dll') Or !Exists('$(InfiniExternalDepsRoot)/Luminance/bin/Debug/net8.0/Luminance.dll')" Text="Set InfiniExternalDepsRoot to the existing ParticleLibrary/Luminance dependency root." />
  </Target>
</Project>
